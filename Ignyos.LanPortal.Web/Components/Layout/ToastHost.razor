@using Ignyos.LanPortal.Web.Services
@implements IDisposable
@inject ToastService Toasts

@foreach (var group in visibleToasts.GroupBy(item => item.Position))
{
    <div class="toast-host toast-host-@group.Key.ToString().ToLowerInvariant()" role="status" aria-live="polite">
        @foreach (var toast in group)
        {
            <div class="toast toast-@toast.Kind.ToString().ToLowerInvariant()">
                <span class="toast-message">@toast.Message</span>
                <button type="button"
                        class="toast-close"
                        title="Dismiss"
                        aria-label="Dismiss notification"
                        @onclick="() => Dismiss(toast.Id)">&times;</button>
            </div>
        }
    </div>
}

@code {
    private readonly List<ToastMessage> visibleToasts = [];
    private readonly Dictionary<Guid, CancellationTokenSource> dismissals = [];

    private void Dismiss(Guid toastId)
    {
        visibleToasts.RemoveAll(item => item.Id == toastId);

        if (dismissals.Remove(toastId, out var source))
        {
            source.Cancel();
            source.Dispose();
        }
    }

    protected override void OnInitialized()
    {
        Toasts.ToastShown += OnToastShown;
    }

    private void OnToastShown(ToastMessage toast)
    {
        _ = InvokeAsync(async () =>
        {
            visibleToasts.Add(toast);
            StateHasChanged();

            var cancellation = new CancellationTokenSource();
            dismissals[toast.Id] = cancellation;
            try
            {
                await Task.Delay(toast.Duration, cancellation.Token);
            }
            catch (OperationCanceledException)
            {
                return;
            }

            visibleToasts.RemoveAll(item => item.Id == toast.Id);
            dismissals.Remove(toast.Id, out var source);
            source?.Dispose();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Toasts.ToastShown -= OnToastShown;
        foreach (var source in dismissals.Values)
        {
            source.Cancel();
            source.Dispose();
        }
    }
}
