@inject Ignyos.LanPortal.Web.Services.PortalConfigClient PortalConfigClient
@inject Ignyos.LanPortal.Web.Services.AuthSession AuthSession
@implements IDisposable

<div class="nav-root">
    <div class="brand-shell">
        <div class="brand-title-wrap">
            <a class="brand-title" href="home">@networkName</a>
            <p class="brand-subtitle">LAN Portal</p>
        </div>
    </div>

    <input type="checkbox" title="Navigation menu" class="nav-toggle" />

    <div class="nav-shell" onclick="document.querySelector('.nav-toggle')?.click()">
        <nav class="nav-stack">
            <div class="nav-item">
                <NavLink class="nav-link" href="home">
                    Home
                </NavLink>
            </div>

            <div class="nav-item">
                @if (hasActiveSession)
                {
                    <NavLink class="nav-link" href="files">
                        Files
                    </NavLink>
                }
                else
                {
                    <button type="button" class="nav-link nav-link-disabled" aria-disabled="true" title="Start by requesting access in Account." @onclick="HandleSignedOutFilesClick">
                        Files
                    </button>
                }
            </div>

            <div class="nav-item @(showAccountAttention ? "account-attention" : string.Empty)">
                <NavLink class="nav-link" href="account">
                    Account
                </NavLink>
                @if (showFilesGuidance)
                {
                    <div class="nav-guidance" role="status">Start by requesting access in Account.</div>
                }
            </div>

            @if (showAdminLink)
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="admin">
                        Admin
                    </NavLink>
                </div>
            }
        </nav>
    </div>
</div>

@code {
    private string networkName = "My Home";
    private bool hasActiveSession;
    private bool showAdminLink;
    private bool showFilesGuidance;
    private bool showAccountAttention;

    protected override async Task OnInitializedAsync()
    {
        networkName = await PortalConfigClient.GetNetworkNameAsync();
        AuthSession.SessionStateChanged += OnSessionStateChanged;
        await AuthSession.InitializeAsync();
        SyncSessionState();
    }

    protected override async Task OnParametersSetAsync()
    {
        await AuthSession.InitializeAsync();
        SyncSessionState();
    }

    private void OnSessionStateChanged()
    {
        SyncSessionState();
        InvokeAsync(StateHasChanged);
    }

    private void SyncSessionState()
    {
        hasActiveSession = AuthSession.HasActiveSession;
        showAdminLink = hasActiveSession && AuthSession.HasRole("Admin");
    }

    private async Task HandleSignedOutFilesClick()
    {
        if (hasActiveSession)
        {
            return;
        }

        showFilesGuidance = true;
        showAccountAttention = true;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(TimeSpan.FromSeconds(4));
        showFilesGuidance = false;
        showAccountAttention = false;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthSession.SessionStateChanged -= OnSessionStateChanged;
    }
}

