@inject Ignyos.LanPortal.Web.Services.PortalConfigClient PortalConfigClient
@inject Ignyos.LanPortal.Web.Services.AuthSession AuthSession
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@networkName</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="login">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Login
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="files">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Files
            </NavLink>
        </div>

        @if (showAdminLink)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin">
                    <span class="bi bi-shield-lock" aria-hidden="true"></span> Admin
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="logout">
                <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Logout
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private string networkName = "My Home";
    private bool showAdminLink;

    protected override async Task OnInitializedAsync()
    {
        networkName = await PortalConfigClient.GetNetworkNameAsync();
        AuthSession.SessionStateChanged += OnSessionStateChanged;
        await AuthSession.InitializeAsync();
        showAdminLink = AuthSession.HasActiveSession;
    }

    protected override async Task OnParametersSetAsync()
    {
        await AuthSession.InitializeAsync();
        showAdminLink = AuthSession.HasActiveSession;
    }

    private void OnSessionStateChanged()
    {
        showAdminLink = AuthSession.HasActiveSession;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthSession.SessionStateChanged -= OnSessionStateChanged;
    }
}

