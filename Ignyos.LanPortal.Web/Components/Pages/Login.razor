@page "/login"
@rendermode InteractiveServer
@using Ignyos.LanPortal.Contracts
@using Ignyos.LanPortal.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@inject AuthApiClient AuthApiClient
@inject AuthSession AuthSession
@inject NavigationManager Navigation
@inject PortalConfigClient PortalConfigClient
@inject IJSRuntime JS

<PageTitle>@networkName - Login</PageTitle>

<section class="view-header">
    <h1>@networkName Login</h1>
    <p>Request access with your name and device, then approve it from the host machine in the local admin console.</p>
</section>

<section class="panel reveal" style="max-width: 38rem;">
    <div class="field">
        <label for="userName">User Name</label>
        <input id="userName" class="input" @bind="userName" />
    </div>

    <div class="field">
        <label for="deviceName">Device</label>
        <input id="deviceName" class="input" @bind="deviceName" />
    </div>

    <div class="actions-row">
        <button class="btn btn-primary" @onclick="StartLoginAsync" disabled="@isBusy">Request Login</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <p class="text-success">@statusMessage</p>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="text-danger">@errorMessage</p>
    }

    @if (!AuthSession.IsLoaded)
    {
        <p>Loading session...</p>
    }

    @if (pendingRequest is not null)
    {
        <div class="notice notice-info text-mono">
            <div><strong>Request ID:</strong> @pendingRequest.RequestId</div>
            <div><strong>User Code:</strong> @pendingRequest.UserCode</div>
            <div><strong>Expires:</strong> @pendingRequest.ExpiresAtUtc.ToString("u")</div>
        </div>
    }

    @if (AuthSession.IsAuthenticated)
    {
        <div class="notice notice-success">
            <div><strong>Authenticated</strong></div>
            <div>Access token expires at @AuthSession.AccessTokenExpiresAtUtc?.ToString("u")</div>
            <div><a href="/account">Go To Account</a></div>
        </div>
    }
</section>

@code {
    private string networkName = "My Home";
    private string userName = string.Empty;
    private string deviceName = "Desktop";
    private string returnUrl = "/files";

    private bool isBusy;
    private string? statusMessage;
    private string? errorMessage;
    private DeviceLoginStartResponseDto? pendingRequest;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        networkName = await PortalConfigClient.GetNetworkNameAsync();
        await AuthSession.InitializeAsync();

        var parsedUri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(parsedUri.Query);
        if (query.TryGetValue("returnUrl", out var requestedReturnUrl))
        {
            var candidate = requestedReturnUrl.ToString();
            if (!string.IsNullOrWhiteSpace(candidate) &&
                candidate.StartsWith('/') &&
                !candidate.StartsWith("//", StringComparison.Ordinal))
            {
                returnUrl = candidate;
            }
        }

        if (AuthSession.HasActiveSession)
        {
            Navigation.NavigateTo(AuthSession.GetPreferredAuthenticatedPath(), forceLoad: false);
            return;
        }

        var suggestedDevice = await DetectDeviceAsync();
        ApplyDeviceSuggestion(suggestedDevice);

        StateHasChanged();
    }

    private async Task StartLoginAsync()
    {
        if (string.IsNullOrWhiteSpace(userName))
        {
            errorMessage = "User Name is required.";
            return;
        }

        var resolvedDeviceName = ResolveDeviceName();
        if (string.IsNullOrWhiteSpace(resolvedDeviceName))
        {
            errorMessage = "Device Name is required.";
            return;
        }

        isBusy = true;
        statusMessage = null;
        errorMessage = null;
        pendingRequest = null;

        try
        {
            pendingRequest = await AuthApiClient.StartLoginAsync(new DeviceLoginStartRequestDto(
                userName.Trim(),
                resolvedDeviceName));

            statusMessage = "Request created. Waiting for approval on Machine A...";

            while (DateTimeOffset.UtcNow < pendingRequest.ExpiresAtUtc)
            {
                await Task.Delay(TimeSpan.FromSeconds(pendingRequest.PollIntervalSeconds));

                var poll = await AuthApiClient.PollLoginAsync(new DeviceLoginPollRequestDto(
                    pendingRequest.RequestId,
                    pendingRequest.UserCode));

                if (poll.Status == "pending")
                {
                    statusMessage = poll.Message ?? "Waiting for approval on Machine A...";
                    StateHasChanged();
                    continue;
                }

                if (poll.Status == "approved" &&
                    !string.IsNullOrWhiteSpace(poll.AccessToken) &&
                    poll.AccessTokenExpiresAtUtc is not null &&
                    !string.IsNullOrWhiteSpace(poll.RefreshToken))
                {
                    await AuthSession.SetTokensAsync(
                        poll.AccessToken,
                        poll.AccessTokenExpiresAtUtc.Value,
                        poll.RefreshToken,
                        poll.RefreshTokenExpiresAtUtc);
                    await AuthSession.RememberPathAsync(returnUrl);
                    statusMessage = "Login approved. Redirecting...";
                    Navigation.NavigateTo(returnUrl);
                    return;
                }

                errorMessage = poll.Message ?? $"Login status: {poll.Status}";
                return;
            }

            errorMessage = "Login request expired before approval.";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private string ResolveDeviceName()
    {
        return deviceName.Trim();
    }

    private async Task<string> DetectDeviceAsync()
    {
        try
        {
            var detected = await JS.InvokeAsync<string?>("lanPortalDevice.getSuggestedDeviceLabel");
            return string.IsNullOrWhiteSpace(detected) ? "Desktop" : detected.Trim();
        }
        catch
        {
            return "Desktop";
        }
    }

    private void ApplyDeviceSuggestion(string suggestedDevice)
        => deviceName = suggestedDevice;
}
