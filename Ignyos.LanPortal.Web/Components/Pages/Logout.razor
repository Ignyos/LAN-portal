@page "/logout"
@rendermode InteractiveServer
@inject Ignyos.LanPortal.Web.Services.AuthSession AuthSession
@inject Ignyos.LanPortal.Web.Services.AuthApiClient AuthApiClient
@inject NavigationManager Navigation

<PageTitle>Logout</PageTitle>

<p>Signing out...</p>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.InitializeAsync();

        // Notify the host so the session appears as logged-out immediately.
        var token = AuthSession.AccessToken;
        if (!string.IsNullOrWhiteSpace(token))
        {
            await AuthApiClient.LogoutAsync(token);
        }

        await AuthSession.ClearAsync();
        Navigation.NavigateTo("/login", forceLoad: false);
    }
}