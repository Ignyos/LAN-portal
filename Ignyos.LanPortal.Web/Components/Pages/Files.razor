@page "/files"
@rendermode InteractiveServer
@using Ignyos.LanPortal.Contracts
@using Ignyos.LanPortal.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@inject FileApiClient FileApiClient
@inject FileEventsClient FileEventsClient
@inject AuthSession AuthSession
@inject ToastService Toasts
@inject ClientLogClient ClientLog
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>File Explorer</PageTitle>

<header class="page-header">
    <p class="eyebrow">File Explorer</p>
</header>

@if (!AuthSession.IsLoaded)
{
    <p>Loading session...</p>
}
else if (!AuthSession.HasActiveSession)
{
    <p class="text-warning">Redirecting to Account...</p>
}
else
{
    <section class="panel reveal stack" @onclick="CloseContextMenu">
        <div class="explorer-upload-area">
            <label class="drop-zone @(CanUpload ? string.Empty : "disabled") @(isDragActive ? "drag-active" : string.Empty)"
                   @ondragenter="HandleDragEnter"
                   @ondragleave="HandleDragLeave"
                   @ondrop="HandleDragDrop">
                <span>@(isDragActive ? "Drop files to upload" : "Drag and drop files")</span>
                <span class="browse-link">Browse for files</span>
                <input type="file"
                       multiple
                       @ref="fileInputElement"
                       disabled="@(!CanUpload || isBusy)"
                       @onchange="HandleFilesSelectedAsync"
                       @oninput="HandleFilesSelectedAsync" />
            </label>
        </div>

        @if (showCreateFolderForm)
        {
            <div class="split">
                <div class="span-8">
                    <label for="new-folder-name">New Folder Name</label>
                    <input id="new-folder-name" class="input" @bind="newFolderName" />
                </div>
                <div class="span-4" style="display:flex; align-items:end; gap:0.55rem;">
                    <button class="btn btn-primary" @onclick="CreateFolderAsync" disabled="@isBusy">Create</button>
                    <button class="btn btn-secondary" @onclick="CancelInlineAction" disabled="@isBusy">Cancel</button>
                </div>
            </div>
        }

        <div class="folder-navigation-row">
            <div class="navigation-icons" aria-label="Folder navigation">
                <button class="icon-button" title="Go back" aria-label="Go back" @onclick="GoBackAsync" disabled="@(!CanGoBack || isBusy)">
                    <img src="assets/Left-Arrow.svg" alt="" />
                </button>
                <button class="icon-button" title="Go forward" aria-label="Go forward" @onclick="GoForwardAsync" disabled="@(!CanGoForward || isBusy)">
                    <img src="assets/Right-Arrow.svg" alt="" />
                </button>
                <button class="icon-button" title="Refresh folder" aria-label="Refresh folder" @onclick="LoadFilesAsync" disabled="@isBusy">
                    <img src="assets/Refresh.svg" alt="" />
                </button>
                <button class="new-folder-button" title="Create a new folder" aria-label="Create a new folder" @onclick="BeginCreateFolder" disabled="@(!CanCreateFolder || isBusy)">
                    <img src="assets/Plus-Circle.svg" alt="" />
                    <span>New Folder</span>
                </button>
            </div>

            <div class="breadcrumb-row" aria-label="Current folder">
                <a href="#" @onclick="() => NavigateToFolderAsync(string.Empty)">~/</a>
                @foreach (var crumb in GetBreadcrumbs())
                {
                    <span>/</span>
                    @if (crumb.IsCurrent)
                    {
                        <span class="breadcrumb-current">@crumb.Name</span>
                    }
                    else
                    {
                        <a href="#" @onclick="() => NavigateToFolderAsync(crumb.Path)">@crumb.Name</a>
                    }
                }
                    </div>
        </div>

        <div class="explorer-grid">
            <aside class="tree-pane">
                <div class="tree-header">Folders</div>
                @if (rootTreeNodes.Count == 0)
                {
                    <p class="text-muted">No folders</p>
                }
                else
                {
                    @TreeBranch(rootTreeNodes)
                }
            </aside>

            <section class="content-pane">
                @if (showSearchResults)
                {
                    @if (searchResults.Count == 0)
                    {
                        <p><em>No search results found.</em></p>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Type</th>
                                        <th>Size</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in searchResults)
                                    {
                                        <tr>
                                            <td>@entry.Name</td>
                                            <td>@GetFileTypeLabel(entry)</td>
                                            <td>@(entry.IsFolder ? string.Empty : entry.SizeBytes?.ToString())</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else
                {
                    @if (folderItems.Count == 0)
                    {
                        <p><em>No files found in storage.</em></p>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>
                                            <input type="checkbox" checked="@AllVisibleSelected" @onchange="ToggleSelectAll" />
                                        </th>
                                        <th>Name</th>
                                        <th>Type</th>
                                        <th>Size</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!string.IsNullOrWhiteSpace(currentFolderPath))
                                    {
                                        <tr>
                                            <td></td>
                                            <td><a href="#" @onclick="NavigateUpAsync">..</a></td>
                                            <td>Folder</td>
                                            <td></td>
                                        </tr>
                                    }

                                    @foreach (var entry in folderItems)
                                    {
                                        <tr class="@(selectedPaths.Contains(entry.Path) ? "row-selected" : string.Empty)"
                                            tabindex="0"
                                            @onclick="() => SelectRow(entry.Path)"
                                            @oncontextmenu="(e) => OpenContextMenu(entry, e)"
                                            @oncontextmenu:preventDefault="true"
                                            @onkeydown="(e) => HandleRowKeyDownAsync(entry, e)"
                                            @ondblclick="() => HandleRowDoubleClickAsync(entry)">
                                            <td>
                                                <input type="checkbox"
                                                       checked="@selectedPaths.Contains(entry.Path)"
                                                       @onclick:stopPropagation="true"
                                                       @onchange="(e) => ToggleSelection(entry.Path, e)" />
                                            </td>
                                            <td>@entry.Name</td>
                                            <td>@GetFileTypeLabel(entry)</td>
                                            <td>@(entry.IsFolder ? string.Empty : entry.SizeBytes?.ToString())</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </section>
        </div>
    </section>

    @if (contextMenuItem is not null)
    {
        <div class="file-context-menu" style="left: @contextMenuLeftPx; top: @contextMenuTopPx;"
               role="menu" tabindex="-1" @onkeydown="HandleContextMenuKeyDown" @onclick:stopPropagation="true">
            <button type="button" role="menuitem"
                    @onclick="DownloadFromContextMenu"
                    disabled="@(!CanContextDownload)">
                Download
            </button>
            <button type="button" role="menuitem"
                    @onclick="RenameFromContextMenu"
                    disabled="@(!CanContextRename)">
                Rename
            </button>
            <button type="button" role="menuitem"
                    @onclick="OpenDeleteConfirmation"
                    disabled="@(!CanContextDelete)">
                Delete
            </button>
        </div>
    }

    @if (showDeleteConfirmation)
    {
        <div class="modal-backdrop" role="presentation" @onclick="CloseDeleteConfirmation">
            <section class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="delete-confirmation-title" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div>
                        <p class="eyebrow">Delete</p>
                        <h2 id="delete-confirmation-title">@DeleteConfirmationTitle</h2>
                    </div>
                    <button type="button" class="modal-close" title="Close" aria-label="Close delete confirmation" @onclick="CloseDeleteConfirmation">&times;</button>
                </div>

                @if (SelectedFolderCount > 0)
                {
                    <div class="notice notice-warning" style="margin-top: 1rem;">
                        The selected folder and everything inside it will be deleted.
                    </div>
                }

                <div class="actions-row modal-actions">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteConfirmation" disabled="@isBusy">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteAsync" disabled="@isBusy">Delete</button>
                </div>
            </section>
        </div>
    }

    @if (showTransferModal)
    {
        <div class="modal-backdrop" role="presentation">
            <section class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="transfer-title" aria-busy="true">
                <div class="modal-header">
                    <div>
                        <p class="eyebrow">Transfer</p>
                        <h2 id="transfer-title">@transferStatus</h2>
                    </div>
                </div>

                <div class="progress-track"
                     role="progressbar"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="@BatchPercent"
                     aria-label="Overall upload progress">
                    <div class="progress-bar" style="width:@(BatchPercent)%"></div>
                </div>
                <p class="text-muted transfer-hint">@FormatBytes(BatchSentBytes) of @FormatBytes(BatchTotalBytes) — @BatchPercent%</p>

                <ul class="transfer-list">
                    @foreach (var item in VisibleUploads)
                    {
                        <li @key="item.Index" class="transfer-item transfer-@item.State.ToString().ToLowerInvariant() @(item.IsLeaving ? "transfer-leaving" : string.Empty)">
                            <div class="transfer-item-row">
                                <span class="transfer-name" title="@item.Name">@item.Name</span>
                                <span class="transfer-size">@FormatBytes(item.SizeBytes)</span>
                            </div>
                            @if (item.State != UploadState.Pending)
                            {
                                <div class="progress-track progress-track-slim">
                                    <div class="progress-bar" style="width:@(item.Percent)%"></div>
                                </div>
                                <div class="transfer-item-status">
                                    @switch (item.State)
                                    {
                                        case UploadState.Uploading:
                                            <span>@item.Percent% — @FormatBytes(item.SentBytes) sent</span>
                                            break;
                                        case UploadState.Completed:
                                            <span class="text-success">Completed</span>
                                            break;
                                        case UploadState.Cancelled:
                                            <span class="text-muted">Cancelled</span>
                                            break;
                                        case UploadState.Failed:
                                            <span class="text-danger">@item.Error</span>
                                            break;
                                    }
                                </div>
                            }
                        </li>
                    }
                </ul>

                <p class="text-muted transfer-hint">Keep this page open until the transfer finishes.</p>

                <div class="modal-actions transfer-actions">
                    <button type="button" class="btn btn-secondary" @onclick="CancelUploadAsync" disabled="@isCancellingUpload">
                        @(isCancellingUpload ? "Cancelling..." : "Cancel transfer")
                    </button>
                </div>
            </section>
        </div>
    }

    <section class="panel reveal permissions-panel">
        <div class="permissions-heading">Your permissions</div>
        <div class="permissions-list">
            <span class="permission-item @(CanUpload ? "permission-enabled" : "permission-disabled")" title="@(CanUpload ? "You can upload files." : "Upload is not available for your access.")">Upload</span>
            <span class="permission-item @(AuthSession.HasPermission(PermissionKeys.Download) ? "permission-enabled" : "permission-disabled")" title="@(AuthSession.HasPermission(PermissionKeys.Download) ? "You can download files." : "Download is not available for your access.")">Download</span>
            <span class="permission-item @(AuthSession.HasPermission(PermissionKeys.Rename) ? "permission-enabled" : "permission-disabled")" title="@(AuthSession.HasPermission(PermissionKeys.Rename) ? "You can rename files and folders." : "Rename is not available for your access.")">Rename</span>
            <span class="permission-item @(AuthSession.HasPermission(PermissionKeys.Delete) ? "permission-enabled" : "permission-disabled")" title="@(AuthSession.HasPermission(PermissionKeys.Delete) ? "You can delete files and folders." : "Delete is not available for your access.")">Delete</span>
            <span class="permission-item @(CanCreateFolder ? "permission-enabled" : "permission-disabled")" title="@(CanCreateFolder ? "You can create folders." : "New Folder is not available for your access.")">New Folder</span>
        </div>
    </section>
}

@code {
    private readonly List<FileNodeDto> folderItems = [];
    private readonly List<FileNodeDto> searchResults = [];
    private readonly HashSet<string> selectedPaths = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<TreeNode> rootTreeNodes = [];
    private readonly Stack<string> backHistory = new();
    private readonly Stack<string> forwardHistory = new();

    private string currentFolderPath = string.Empty;
    private string newFolderName = string.Empty;
    private string renameTargetName = string.Empty;
    private string moveDestinationPath = string.Empty;
    private string searchQuery = string.Empty;

    private bool isBusy;
    private bool showCreateFolderForm;
    private bool showRenameForm;
    private bool showMoveForm;
    private bool showSearchResults;
    private bool hasPendingEventRefresh;
    private FileNodeDto? contextMenuItem;
    private string contextMenuLeftPx = "0px";
    private string contextMenuTopPx = "0px";
    private bool showDeleteConfirmation;
    private bool isDragActive;
    private int dragDepth;
    private bool showTransferModal;
    private string transferStatus = string.Empty;
    private bool isCancellingUpload;
    private bool isProcessingSelection;
    private string uploadBatchId = string.Empty;
    private ElementReference fileInputElement;
    private DotNetObjectReference<Files>? selfReference;
    private readonly List<UploadItem> uploadQueue = [];

    private bool CanCreateFolder => AuthSession.HasPermission(PermissionKeys.NewFolder);
    private bool CanUpload => AuthSession.HasPermission(PermissionKeys.Upload);
    private bool CanSearch => AuthSession.HasPermission(PermissionKeys.Search);
    private bool CanRenameSelection => AuthSession.HasPermission(PermissionKeys.Rename) && selectedPaths.Count == 1 && !showSearchResults;
    private bool CanMoveSelection => AuthSession.HasPermission(PermissionKeys.Move) && selectedPaths.Count > 0 && !showSearchResults;
    private bool CanDeleteSelection => AuthSession.HasPermission(PermissionKeys.Delete) && selectedPaths.Count > 0 && !showSearchResults;
    private bool CanDownloadSelection =>
        AuthSession.HasPermission(PermissionKeys.Download) &&
        selectedPaths.Count == 1 &&
        folderItems.Any(item => selectedPaths.Contains(item.Path) && !item.IsFolder) &&
        !showSearchResults;
    private bool AllVisibleSelected => folderItems.Count > 0 && folderItems.All(item => selectedPaths.Contains(item.Path));
    private bool CanGoBack => backHistory.Count > 0;
    private bool CanGoForward => forwardHistory.Count > 0;
    private bool CanContextDownload => contextMenuItem is not null && !contextMenuItem.IsFolder && AuthSession.HasPermission(PermissionKeys.Download);
    private bool CanContextRename => contextMenuItem is not null && AuthSession.HasPermission(PermissionKeys.Rename);
    private bool CanContextDelete => contextMenuItem is not null && AuthSession.HasPermission(PermissionKeys.Delete);
    private int SelectedFolderCount => folderItems.Count(item => selectedPaths.Contains(item.Path) && item.IsFolder);
    private string DeleteConfirmationTitle => selectedPaths.Count == 1
        ? $"Delete \"{folderItems.FirstOrDefault(item => selectedPaths.Contains(item.Path))?.Name}\"?"
        : $"Delete {selectedPaths.Count} selected items?";

    private RenderFragment TreeBranch(IEnumerable<TreeNode> nodes) => __builder =>
    {
        var seq = 0;
        __builder.OpenElement(seq++, "ul");
        __builder.AddAttribute(seq++, "class", "tree-list");

        foreach (var node in nodes.OrderBy(n => n.Name, StringComparer.OrdinalIgnoreCase))
        {
            __builder.OpenElement(seq++, "li");

            __builder.OpenElement(seq++, "div");
            __builder.AddAttribute(seq++, "class", $"tree-node-row {(IsCurrentPath(node.Path) ? "active" : string.Empty)}");

            __builder.OpenElement(seq++, "button");
            __builder.AddAttribute(seq++, "class", "tree-toggle");
            __builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => ToggleTreeNodeAsync(node)));
            __builder.AddContent(seq++, node.IsExpanded ? "▾" : "▸");
            __builder.CloseElement();

            __builder.OpenElement(seq++, "button");
            __builder.AddAttribute(seq++, "class", "tree-link");
            __builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => NavigateToFolderAsync(node.Path)));
            __builder.AddContent(seq++, node.Name);
            __builder.CloseElement();

            __builder.CloseElement();

            if (node.IsExpanded)
            {
                if (node.IsLoading)
                {
                    __builder.OpenElement(seq++, "div");
                    __builder.AddAttribute(seq++, "class", "text-muted");
                    __builder.AddContent(seq++, "Loading...");
                    __builder.CloseElement();
                }
                else
                {
                    __builder.AddContent(seq++, TreeBranch(node.Children));
                }
            }

            __builder.CloseElement();
        }

        __builder.CloseElement();
    };

    protected override Task OnInitializedAsync()
    {
        FileEventsClient.FileChanged += OnFileChanged;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await AuthSession.InitializeAsync();
            StateHasChanged();

            if (!AuthSession.HasActiveSession)
            {
                var returnUrl = Uri.EscapeDataString("/files");
                Navigation.NavigateTo($"/account?returnUrl={returnUrl}", forceLoad: false);
                return;
            }

            await AuthSession.RememberPathAsync("/files");
            await FileEventsClient.StartAsync();
            await EnsureTreeLoadedAsync();
            await LoadCurrentFolderAsync();
            await EnsureTreePathExpandedAsync(currentFolderPath);
            await SyncSubscriptionsAsync();
            StateHasChanged();
        }
        catch (SessionRevokedException ex)
        {
            var reason = await AuthSession.HandleUnauthorizedAccessAsync();
            await HandleUnauthorizedAsync("Your session has ended. Please request access again.", reason);
            StateHasChanged();
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
            StateHasChanged();
        }
        catch (HttpRequestException ex) when (ex.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
        {
            var reason = await AuthSession.HandleUnauthorizedAccessAsync();
            await HandleUnauthorizedAsync("Your session has ended. Please request access again.", reason);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await ReportErrorAsync("Unable to initialize Files view.", ex);
            StateHasChanged();
        }
    }

    private async Task HandleFilesSelectedAsync()
    {
        // Some mobile browsers only raise one of change/input for multi-file selections;
        // both are wired to this handler, so guard against processing the same selection twice.
        if (isProcessingSelection)
        {
            return;
        }

        isProcessingSelection = true;
        try
        {
            await ProcessFileSelectionAsync();
        }
        finally
        {
            isProcessingSelection = false;
        }
    }

    private async Task ProcessFileSelectionAsync()
    {
        ResetDragState();

        if (!CanUpload)
        {
            return;
        }

        SelectedFileInfo[] selected;
        try
        {
            selected = await JS.InvokeAsync<SelectedFileInfo[]>("lanPortalUpload.getSelectedFiles", fileInputElement);
        }
        catch (Exception ex)
        {
            await ReportErrorAsync("Could not read the selected files.", ex);
            return;
        }

        if (selected.Length == 0)
        {
            // The browser only raises change/input when the selection actually changed, so an
            // empty result here (rather than no event at all) points at a real client-side bug.
            Toasts.Warning("No files were detected from that selection. Please try again.");
            await ClientLog.ReportErrorAsync(
                "File picker fired but no files were returned.",
                source: "Files.razor",
                correlationId: CreateCorrelationId());
            return;
        }

        if (!await PassesPreflightAsync(selected))
        {
            await JS.InvokeVoidAsync("lanPortalUpload.clearSelection", fileInputElement);
            return;
        }

        uploadQueue.Clear();
        uploadQueue.AddRange(selected.Select((file, index) => new UploadItem
        {
            Index = index,
            Name = file.Name,
            SizeBytes = file.Size
        }));

        isBusy = true;
        isCancellingUpload = false;
        uploadBatchId = Guid.NewGuid().ToString("N");
        showTransferModal = true;
        transferStatus = uploadQueue.Count == 1 ? "Uploading 1 file" : $"Uploading {uploadQueue.Count} files";
        selfReference ??= DotNetObjectReference.Create(this);

        StateHasChanged();
        await Task.Yield();

        try
        {
            var options = new
            {
                apiBaseUrl = FileApiClient.GetApiBaseUrl(),
                accessToken = AuthSession.AccessToken,
                currentPath = currentFolderPath,
                correlationId = CreateCorrelationId(),
                batchId = uploadBatchId,
                stopOnError = false
            };

            // An explicit token opts out of the 1 minute default JS interop timeout,
            // which would otherwise abandon the await while the browser is still uploading.
            var results = await JS.InvokeAsync<UploadResult[]>(
                "lanPortalUpload.uploadFiles",
                CancellationToken.None,
                fileInputElement,
                options,
                selfReference);

            ApplyUploadResults(results);

            var succeeded = results.Count(result => result.Succeeded);
            var cancelled = results.Count(result => result.Cancelled);
            var failed = results.Length - succeeded - cancelled;

            if (cancelled > 0)
            {
                Toasts.Warning(succeeded == 0
                    ? "Transfer cancelled."
                    : $"Transfer cancelled. {succeeded} file(s) finished before cancelling.");
            }

            if (failed == 0)
            {
                if (cancelled == 0)
                {
                    Toasts.Success(succeeded == 1 ? "Uploaded 1 file." : $"Uploaded {succeeded} files.");
                }
            }
            else
            {
                var firstError = results.FirstOrDefault(result => !result.Succeeded && !result.Cancelled)?.Error;
                await ReportUploadFailuresAsync(succeeded, failed, firstError);
            }

            await LoadCurrentFolderAsync();
            await EnsureTreeLoadedAsync(forceReload: true);
            await EnsureTreePathExpandedAsync(currentFolderPath);
        }
        catch (Exception ex)
        {
            await ReportErrorAsync("Upload failed.", ex);
        }
        finally
        {
            showTransferModal = false;
            uploadQueue.Clear();
            transferStatus = string.Empty;
            uploadBatchId = string.Empty;
            isCancellingUpload = false;
            isBusy = false;
        }
    }

    private async Task CancelUploadAsync()
    {
        if (isCancellingUpload || string.IsNullOrEmpty(uploadBatchId))
        {
            return;
        }

        isCancellingUpload = true;
        transferStatus = "Cancelling transfer";

        try
        {
            await JS.InvokeVoidAsync("lanPortalUpload.cancel", uploadBatchId);
        }
        catch (Exception ex)
        {
            await ClientLog.ReportErrorAsync("Could not cancel the transfer.", ex, source: "Files.razor");
        }
    }

    private async Task<bool> PassesPreflightAsync(IReadOnlyList<SelectedFileInfo> selected)
    {
        var emptyFiles = selected.Where(file => file.Size <= 0).ToArray();
        if (emptyFiles.Length == selected.Count)
        {
            Toasts.Warning("The selected file(s) are empty and cannot be uploaded.");
            return false;
        }

        var totalBytes = selected.Sum(file => file.Size);

        try
        {
            var storage = await FileApiClient.GetStorageInfoAsync();
            if (totalBytes > storage.AvailableFreeSpaceBytes)
            {
                Toasts.Error(
                    $"Not enough space on the host. This transfer needs {FormatBytes(totalBytes)} but only {FormatBytes(storage.AvailableFreeSpaceBytes)} is free.");
                return false;
            }
        }
        catch (Exception ex)
        {
            // A failed space check should not block an otherwise valid transfer.
            await ClientLog.ReportErrorAsync("Storage pre-flight check failed.", ex, source: "Files.razor");
        }

        return true;
    }

    private void ApplyUploadResults(IReadOnlyList<UploadResult> results)
    {
        for (var index = 0; index < results.Count && index < uploadQueue.Count; index++)
        {
            var item = uploadQueue[index];
            item.Error = results[index].Error;

            if (results[index].Succeeded)
            {
                item.State = UploadState.Completed;
                item.SentBytes = item.SizeBytes;
            }
            else
            {
                item.State = results[index].Cancelled ? UploadState.Cancelled : UploadState.Failed;
            }
        }
    }

    private async Task ReportUploadFailuresAsync(int succeeded, int failed, string? firstError)
    {
        var summary = succeeded == 0
            ? $"Upload failed for {failed} file(s)."
            : $"Uploaded {succeeded} file(s); {failed} failed.";

        Toasts.Error(string.IsNullOrWhiteSpace(firstError) ? summary : $"{summary} {firstError}");

        await ClientLog.ReportErrorAsync(
            summary,
            source: "Files.razor",
            correlationId: CreateCorrelationId(),
            detailsJson: firstError);
    }

    [JSInvokable]
    public Task OnUploadProgress(int index, long sentBytes, long totalBytes)
    {
        if (index < 0 || index >= uploadQueue.Count)
        {
            return Task.CompletedTask;
        }

        var item = uploadQueue[index];
        item.State = UploadState.Uploading;
        item.SentBytes = Math.Min(sentBytes, item.SizeBytes);

        for (var earlier = 0; earlier < index; earlier++)
        {
            if (uploadQueue[earlier].State == UploadState.Uploading)
            {
                uploadQueue[earlier].State = UploadState.Completed;
                uploadQueue[earlier].SentBytes = uploadQueue[earlier].SizeBytes;
                _ = FadeOutCompletedAsync(uploadQueue[earlier]);
            }
        }

        return InvokeAsync(StateHasChanged);
    }

    // Completed rows fade out, then drop from the list so the active upload rises to the top.
    private async Task FadeOutCompletedAsync(UploadItem item)
    {
        item.IsLeaving = true;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(TransferRowFadeOut);

        item.IsRemoved = true;
        await InvokeAsync(StateHasChanged);
    }

    private static readonly TimeSpan TransferRowFadeOut = TimeSpan.FromMilliseconds(420);

    private IEnumerable<UploadItem> VisibleUploads => uploadQueue.Where(item => !item.IsRemoved);

    private long BatchTotalBytes => uploadQueue.Sum(item => item.SizeBytes);
    private long BatchSentBytes => uploadQueue.Sum(item => item.SentBytes);
    private int BatchPercent => BatchTotalBytes <= 0
        ? 0
        : (int)Math.Clamp(BatchSentBytes * 100 / BatchTotalBytes, 0, 100);

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double value = bytes;
        var unitIndex = 0;

        while (value >= 1024 && unitIndex < units.Length - 1)
        {
            value /= 1024;
            unitIndex++;
        }

        return unitIndex == 0 ? $"{bytes} {units[unitIndex]}" : $"{value:0.##} {units[unitIndex]}";
    }

    private enum UploadState
    {
        Pending,
        Uploading,
        Completed,
        Cancelled,
        Failed
    }

    private sealed class UploadItem
    {
        public int Index { get; init; }
        public string Name { get; init; } = string.Empty;
        public long SizeBytes { get; init; }
        public long SentBytes { get; set; }
        public UploadState State { get; set; } = UploadState.Pending;
        public string? Error { get; set; }
        public bool IsLeaving { get; set; }
        public bool IsRemoved { get; set; }

        public int Percent => SizeBytes <= 0
            ? 0
            : (int)Math.Clamp(SentBytes * 100 / SizeBytes, 0, 100);
    }

    private sealed record SelectedFileInfo(int Index, string Name, long Size);

    private sealed record UploadResult(string Name, long SizeBytes, bool Succeeded, bool Cancelled, string? Error);

    private void HandleDragEnter(DragEventArgs args)
    {
        if (!CanUpload || isBusy || !ContainsFiles(args))
        {
            return;
        }

        dragDepth++;
        isDragActive = true;
    }

    private void HandleDragLeave(DragEventArgs args)
    {
        dragDepth = Math.Max(0, dragDepth - 1);

        if (dragDepth == 0)
        {
            isDragActive = false;
        }
    }

    private void HandleDragDrop(DragEventArgs args)
    {
        ResetDragState();
    }

    private void ResetDragState()
    {
        dragDepth = 0;
        isDragActive = false;
    }

    /// <summary>Distinguishes a file drag from text or element drags so the drop zone only reacts to files.</summary>
    private static bool ContainsFiles(DragEventArgs args)
    {
        return args.DataTransfer?.Types?.Any(type => string.Equals(type, "Files", StringComparison.OrdinalIgnoreCase)) == true;
    }

    private async Task ReportErrorAsync(string message, Exception? exception = null)
    {
        var detail = exception is null
            ? message
            : $"{message} {ClientLogClient.DescribeException(exception)}";

        Toasts.Error(detail);
        await ClientLog.ReportErrorAsync(message, exception, source: "Files.razor", correlationId: CreateCorrelationId());
    }

    private async Task LoadFilesAsync()
    {
        await LoadCurrentFolderAsync();
        await EnsureTreeLoadedAsync(forceReload: true);
        await EnsureTreePathExpandedAsync(currentFolderPath);
    }

    private async Task LoadCurrentFolderAsync()
    {
        isBusy = true;

        try
        {
            var response = await FileApiClient.ListFolderAsync(currentFolderPath);
            currentFolderPath = NormalizePath(response.CurrentPath);
            folderItems.Clear();
            folderItems.AddRange(response.Items);
            PruneSelection();
            await SyncSubscriptionsAsync();
        }
        catch (SessionRevokedException ex)
        {
            var reason = await AuthSession.HandleUnauthorizedAccessAsync();
            await HandleUnauthorizedAsync("Your session has ended. Please request access again.", reason);
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            await ReportErrorAsync("Unable to load the current folder.", ex);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleUnauthorizedAsync(string? message, string? reason = null)
    {
        await AuthSession.ClearAsync();
        var returnUrl = Uri.EscapeDataString("/files");
        var reasonParam = !string.IsNullOrWhiteSpace(reason) ? $"&reason={reason}" : string.Empty;
        Navigation.NavigateTo($"/account?returnUrl={returnUrl}{reasonParam}", forceLoad: false);

        if (!string.IsNullOrWhiteSpace(message))
        {
            Toasts.Warning(message);
        }
    }

    private async Task SyncSubscriptionsAsync()
    {
        try
        {
            await FileEventsClient.SetSubscriptionsAsync([currentFolderPath]);
        }
        catch (SessionRevokedException ex)
        {
            var reason = await AuthSession.HandleUnauthorizedAccessAsync();
            await HandleUnauthorizedAsync("Your session has ended. Please request access again.", reason);
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            Toasts.Warning($"Real-time updates unavailable. {ex.Message}");
        }
    }

    private void OnFileChanged(FileChangeEventDto change)
    {
        if (!IsEventRelevant(change, currentFolderPath))
        {
            return;
        }

        hasPendingEventRefresh = true;
        _ = InvokeAsync(RefreshFromEventAsync);
    }

    private async Task RefreshFromEventAsync()
    {
        if (isBusy || !hasPendingEventRefresh)
        {
            return;
        }

        try
        {
            hasPendingEventRefresh = false;
            Toasts.Info("Folder updated.");
            await LoadCurrentFolderAsync();
            await EnsureTreeLoadedAsync(forceReload: true);
            await EnsureTreePathExpandedAsync(currentFolderPath);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await ReportErrorAsync("Failed to refresh after a file update event.", ex);
            StateHasChanged();
        }
    }

    private static bool IsEventRelevant(FileChangeEventDto change, string currentPath)
    {
        var normalizedCurrentPath = NormalizePath(currentPath);
        var normalizedScopePath = NormalizePath(change.ScopePath);

        return string.Equals(normalizedCurrentPath, normalizedScopePath, StringComparison.OrdinalIgnoreCase) ||
            normalizedCurrentPath.StartsWith(normalizedScopePath + "/", StringComparison.OrdinalIgnoreCase) ||
            normalizedScopePath.StartsWith(normalizedCurrentPath + "/", StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizePath(string? path)
    {
        return string.IsNullOrWhiteSpace(path)
            ? string.Empty
            : path.Replace('\\', '/').Trim('/');
    }

    private async Task NavigateToFolderAsync(string path)
    {
        var normalizedTarget = NormalizePath(path);
        if (!string.Equals(normalizedTarget, currentFolderPath, StringComparison.OrdinalIgnoreCase))
        {
            backHistory.Push(currentFolderPath);
            forwardHistory.Clear();
        }

        currentFolderPath = normalizedTarget;
        selectedPaths.Clear();
        showSearchResults = false;
        await LoadCurrentFolderAsync();
        await EnsureTreePathExpandedAsync(currentFolderPath);
    }

    private async Task GoBackAsync()
    {
        if (!CanGoBack)
        {
            return;
        }

        forwardHistory.Push(currentFolderPath);
        var target = backHistory.Pop();
        currentFolderPath = NormalizePath(target);
        selectedPaths.Clear();
        showSearchResults = false;
        await LoadCurrentFolderAsync();
        await EnsureTreePathExpandedAsync(currentFolderPath);
    }

    private async Task GoForwardAsync()
    {
        if (!CanGoForward)
        {
            return;
        }

        backHistory.Push(currentFolderPath);
        var target = forwardHistory.Pop();
        currentFolderPath = NormalizePath(target);
        selectedPaths.Clear();
        showSearchResults = false;
        await LoadCurrentFolderAsync();
        await EnsureTreePathExpandedAsync(currentFolderPath);
    }

    private async Task NavigateUpAsync()
    {
        if (string.IsNullOrWhiteSpace(currentFolderPath))
        {
            return;
        }

        var parts = currentFolderPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var parentPath = parts.Length <= 1
            ? string.Empty
            : string.Join('/', parts.Take(parts.Length - 1));

        await NavigateToFolderAsync(parentPath);
    }

    private async Task HandleRowDoubleClickAsync(FileNodeDto item)
