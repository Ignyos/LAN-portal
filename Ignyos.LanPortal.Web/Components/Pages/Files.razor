        isBusy = true;

        try
        {
            await FileApiClient.CreateFolderAsync(currentFolderPath, folderName, CreateCorrelationId());
            Toasts.Success($"Created folder '{folderName}'.");
            CancelInlineAction();
            await LoadCurrentFolderAsync();
            await EnsureTreeLoadedAsync(forceReload: true);
            await EnsureTreePathExpandedAsync(currentFolderPath);
        }
        catch (SessionRevokedException ex)
        {
            var reason = await AuthSession.HandleUnauthorizedAccessAsync();
            await HandleUnauthorizedAsync("Your session has ended. Please request access again.", reason);
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            await ReportErrorAsync($"Could not create folder '{folderName}'.", ex);
        }
        finally
        {
            isBusy = false;
        }
    }

