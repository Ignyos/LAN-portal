    private void PruneSelection()
    {
        var visiblePaths = folderItems.Select(item => item.Path).ToHashSet(StringComparer.OrdinalIgnoreCase);
        selectedPaths.RemoveWhere(path => !visiblePaths.Contains(path));
    }

    private IEnumerable<BreadcrumbItem> GetBreadcrumbs()
    {
        if (string.IsNullOrWhiteSpace(currentFolderPath))
        {
            yield break;
        }

        var segments = currentFolderPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        for (var i = 0; i < segments.Length; i++)
        {
            var path = string.Join('/', segments.Take(i + 1));
            yield return new BreadcrumbItem(segments[i], path, i == segments.Length - 1);
        }
    }

    private async Task EnsureTreeLoadedAsync(bool forceReload = false)
    {
        if (rootTreeNodes.Count > 0 && !forceReload)
        {
            return;
        }

        var children = await FileApiClient.ListTreeChildrenAsync(string.Empty);
        rootTreeNodes.Clear();
        foreach (var child in children.Children)
        {
            rootTreeNodes.Add(ToTreeNode(child));
        }
    }

    private async Task ToggleTreeNodeAsync(TreeNode node)
    {
        if (!node.IsExpanded)
        {
            await LoadTreeChildrenAsync(node);
            node.IsExpanded = true;
        }
        else
        {
            node.IsExpanded = false;
        }
    }

    private async Task LoadTreeChildrenAsync(TreeNode node)
    {
        if (node.HasLoadedChildren)
        {
            return;
        }

        node.IsLoading = true;
        StateHasChanged();

        try
        {
            var response = await FileApiClient.ListTreeChildrenAsync(node.Path);
            node.Children.Clear();
            foreach (var child in response.Children)
            {
                node.Children.Add(ToTreeNode(child));
            }

            node.HasLoadedChildren = true;
        }
        finally
        {
            node.IsLoading = false;
        }
    }

    private async Task EnsureTreePathExpandedAsync(string path)
    {
        var normalizedPath = NormalizePath(path);
        if (string.IsNullOrWhiteSpace(normalizedPath))
        {
            return;
        }

        var segments = normalizedPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var runningPath = string.Empty;
        var currentNodes = rootTreeNodes;

        for (var i = 0; i < segments.Length; i++)
        {
            runningPath = string.IsNullOrWhiteSpace(runningPath)
                ? segments[i]
                : $"{runningPath}/{segments[i]}";

            var match = currentNodes.FirstOrDefault(node => string.Equals(node.Path, runningPath, StringComparison.OrdinalIgnoreCase));
            if (match is null)
            {
                break;
            }

            match.IsExpanded = true;

            if (i < segments.Length - 1)
            {
                await LoadTreeChildrenAsync(match);
                currentNodes = match.Children;
            }
        }

        StateHasChanged();
    }

    private bool IsCurrentPath(string path)
        => string.Equals(NormalizePath(path), currentFolderPath, StringComparison.OrdinalIgnoreCase);

    private static TreeNode ToTreeNode(FileNodeDto dto)
        => new()
        {
            Path = NormalizePath(dto.Path),
            Name = dto.Name,
            IsExpanded = false,
            IsLoading = false,
            HasLoadedChildren = false
        };

    private static bool IsChecked(object? value)
        => value is bool boolValue
            ? boolValue
            : string.Equals(value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    private static string FormatLocalDateTime(DateTimeOffset? value, string fallback = "n/a")
        => value is null ? fallback : value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private static string GetFileTypeLabel(FileNodeDto entry)
    {
        if (entry.IsFolder)
        {
            return "Folder";
        }

        var extension = Path.GetExtension(entry.Name);
        return string.IsNullOrWhiteSpace(extension)
            ? "File"
            : extension.TrimStart('.').ToUpperInvariant();
    }

    private static string CreateCorrelationId()
        => Guid.NewGuid().ToString("N");

    public async ValueTask DisposeAsync()
    {
        FileEventsClient.FileChanged -= OnFileChanged;
        selfReference?.Dispose();
        await FileEventsClient.DisposeAsync();
    }

    private sealed record BreadcrumbItem(string Name, string Path, bool IsCurrent);

    private sealed class TreeNode
    {
        public string Path { get; init; } = string.Empty;
        public string Name { get; init; } = string.Empty;
        public bool IsExpanded { get; set; }
        public bool IsLoading { get; set; }
        public bool HasLoadedChildren { get; set; }
        public List<TreeNode> Children { get; } = [];
    }
