    private Task HandleRowKeyDownAsync(FileNodeDto item, KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseContextMenu();
            return Task.CompletedTask;
        }

        if (args.Key is "ContextMenu" or "F10" && (args.Key == "ContextMenu" || args.ShiftKey))
        {
            OpenContextMenu(item, new MouseEventArgs { ClientX = 24, ClientY = 24 });
        }

        return Task.CompletedTask;
    }

    private Task HandleContextMenuKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
