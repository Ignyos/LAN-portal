    private async Task RunSearchAsync()
    {
        if (!CanSearch)
        {
            return;
        }

        var query = searchQuery.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            Toasts.Warning("Search query is required.");
            return;
        }

        isBusy = true;

        try
        {
            var response = await FileApiClient.SearchAsync(query, currentFolderPath);
            searchResults.Clear();
            searchResults.AddRange(response.Items);
            showSearchResults = true;
            selectedPaths.Clear();
            Toasts.Info($"Search returned {searchResults.Count} item(s).");
        }
        catch (SessionRevokedException ex)
        {
            var reason = await AuthSession.HandleUnauthorizedAccessAsync();
            await HandleUnauthorizedAsync("Your session has ended. Please request access again.", reason);
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            await ReportErrorAsync("Search failed.", ex);
        }
        finally
        {
            isBusy = false;
        }
    }

