@page "/files"
@rendermode InteractiveServer
@using Ignyos.LanPortal.Contracts
@using Ignyos.LanPortal.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@inject FileApiClient FileApiClient
@inject FileEventsClient FileEventsClient
@inject AuthSession AuthSession
@implements IAsyncDisposable

<PageTitle>Files</PageTitle>

<section class="view-header">
    <h1>File Explorer</h1>
    <p>Browse files and folders from Machine A storage.</p>
</section>

@if (!AuthSession.IsLoaded)
{
    <p>Loading session...</p>
}
else if (!AuthSession.HasActiveSession)
{
    <p class="text-warning">Redirecting to login...</p>
}
else
{
    <section class="panel reveal stack">
        <div class="actions-row">
            <label class="drop-zone @(CanUpload ? string.Empty : "disabled")">
                <span>Drop files here or choose files</span>
                <InputFile OnChange="HandleUploadAsync" multiple disabled="@(!CanUpload || isBusy)" />
            </label>
            <button class="btn btn-secondary" @onclick="LoadFilesAsync" disabled="@isBusy">Refresh</button>
            <button class="btn btn-outline" @onclick="GoBackAsync" disabled="@(!CanGoBack || isBusy)">Back</button>
            <button class="btn btn-outline" @onclick="GoForwardAsync" disabled="@(!CanGoForward || isBusy)">Forward</button>
        </div>

        <div class="actions-row" style="margin-top: 0.2rem;">
            <button class="btn btn-outline" @onclick="BeginCreateFolder" disabled="@(!CanCreateFolder || isBusy)">New Folder</button>
            <button class="btn btn-outline" @onclick="BeginRename" disabled="@(!CanRenameSelection || isBusy)">Rename</button>
            <button class="btn btn-outline" @onclick="BeginMove" disabled="@(!CanMoveSelection || isBusy)">Move</button>
            <button class="btn btn-danger-outline" @onclick="DeleteSelectedAsync" disabled="@(!CanDeleteSelection || isBusy)">Delete</button>
            <button class="btn btn-secondary" @onclick="DownloadSelected" disabled="@(!CanDownloadSelection || isBusy)">Download</button>
            <span class="text-muted">Selected: @selectedPaths.Count</span>
        </div>

        <div class="split" style="align-items: end;">
            <div class="span-8">
                <label for="search-query">Search in current path (explicit only)</label>
                <input id="search-query" class="input" @bind="searchQuery" @bind:event="oninput" placeholder="Enter filename or folder name" />
            </div>
            <div class="span-4" style="display:flex; gap:0.55rem;">
                <button class="btn btn-primary" @onclick="RunSearchAsync" disabled="@(isBusy || !CanSearch)">Search</button>
                <button class="btn btn-secondary" @onclick="ClearSearch" disabled="@(isBusy || !showSearchResults)">Clear Search</button>
            </div>
        </div>

        @if (showCreateFolderForm)
        {
            <div class="split">
                <div class="span-8">
                    <label for="new-folder-name">New Folder Name</label>
                    <input id="new-folder-name" class="input" @bind="newFolderName" />
                </div>
                <div class="span-4" style="display:flex; align-items:end; gap:0.55rem;">
                    <button class="btn btn-primary" @onclick="CreateFolderAsync" disabled="@isBusy">Create</button>
                    <button class="btn btn-secondary" @onclick="CancelInlineAction" disabled="@isBusy">Cancel</button>
                </div>
            </div>
        }

        @if (showRenameForm)
        {
            <div class="split">
                <div class="span-8">
                    <label for="rename-item-name">New Name</label>
                    <input id="rename-item-name" class="input" @bind="renameTargetName" />
                </div>
                <div class="span-4" style="display:flex; align-items:end; gap:0.55rem;">
                    <button class="btn btn-primary" @onclick="RenameSelectedAsync" disabled="@isBusy">Apply Rename</button>
                    <button class="btn btn-secondary" @onclick="CancelInlineAction" disabled="@isBusy">Cancel</button>
                </div>
            </div>
        }

        @if (showMoveForm)
        {
            <div class="split">
                <div class="span-8">
                    <label for="move-destination-path">Destination Path (blank = Root)</label>
                    <input id="move-destination-path" class="input" @bind="moveDestinationPath" placeholder="example: photos/2026" />
                </div>
                <div class="span-4" style="display:flex; align-items:end; gap:0.55rem;">
                    <button class="btn btn-primary" @onclick="MoveSelectedAsync" disabled="@isBusy">Move Selected</button>
                    <button class="btn btn-secondary" @onclick="CancelInlineAction" disabled="@isBusy">Cancel</button>
                </div>
            </div>
        }

        <div>
            <div class="breadcrumb-row">
                <a href="#" @onclick="() => NavigateToFolderAsync(string.Empty)">Root</a>
                @foreach (var crumb in GetBreadcrumbs())
                {
                    <span>/</span>
                    @if (crumb.IsCurrent)
                    {
                        <span class="breadcrumb-current">@crumb.Name</span>
                    }
                    else
                    {
                        <a href="#" @onclick="() => NavigateToFolderAsync(crumb.Path)">@crumb.Name</a>
                    }
                }
            </div>
            <div class="text-muted text-mono">Current folder: @(string.IsNullOrWhiteSpace(currentFolderPath) ? "Root" : currentFolderPath)</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <p class="text-success">@statusMessage</p>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="text-danger">@errorMessage</p>
        }

        <div class="explorer-grid">
            <aside class="tree-pane">
                <div class="tree-header">Folders</div>
                <button class="tree-link root-link" @onclick="() => NavigateToFolderAsync(string.Empty)">Root</button>
                @if (rootTreeNodes.Count == 0)
                {
                    <p class="text-muted">No folders</p>
                }
                else
                {
                    @TreeBranch(rootTreeNodes)
                }
            </aside>

            <section class="content-pane">
                @if (showSearchResults)
                {
                    @if (searchResults.Count == 0)
                    {
                        <p><em>No search results found.</em></p>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Type</th>
                                        <th>Path</th>
                                        <th>Size (bytes)</th>
                                        <th>Last Modified (UTC)</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in searchResults)
                                    {
                                        <tr>
                                            <td>@entry.Name</td>
                                            <td>@(entry.IsFolder ? "Folder" : "File")</td>
                                            <td class="text-mono">@entry.Path</td>
                                            <td>@(entry.IsFolder ? string.Empty : entry.SizeBytes?.ToString())</td>
                                            <td>@(entry.LastModifiedUtc?.ToString("u"))</td>
                                            <td>
                                                @if (entry.IsFolder)
                                                {
                                                    <a href="#" @onclick="() => OpenFromSearchAsync(entry.Path)">Open</a>
                                                }
                                                else
                                                {
                                                    <a href="@FileApiClient.BuildDownloadUrl(entry.Path)">Download</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else
                {
                    @if (folderItems.Count == 0)
                    {
                        <p><em>No files found in storage.</em></p>
                    }
                    else
                    {
                        <div class="table-wrap">
                            <table>
                                <thead>
                                    <tr>
                                        <th>
                                            <input type="checkbox" checked="@AllVisibleSelected" @onchange="ToggleSelectAll" />
                                        </th>
                                        <th>Name</th>
                                        <th>Type</th>
                                        <th>Size (bytes)</th>
                                        <th>Last Modified (UTC)</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!string.IsNullOrWhiteSpace(currentFolderPath))
                                    {
                                        <tr>
                                            <td></td>
                                            <td><a href="#" @onclick="NavigateUpAsync">..</a></td>
                                            <td>Folder</td>
                                            <td></td>
                                            <td></td>
                                            <td><a href="#" @onclick="NavigateUpAsync">Open</a></td>
                                        </tr>
                                    }

                                    @foreach (var entry in folderItems)
                                    {
                                        <tr class="@(selectedPaths.Contains(entry.Path) ? "row-selected" : string.Empty)"
                                            @ondblclick="() => HandleRowDoubleClickAsync(entry)">
                                            <td>
                                                <input type="checkbox"
                                                       checked="@selectedPaths.Contains(entry.Path)"
                                                       @onchange="(e) => ToggleSelection(entry.Path, e)" />
                                            </td>
                                            <td>@entry.Name</td>
                                            <td>@(entry.IsFolder ? "Folder" : "File")</td>
                                            <td>@(entry.IsFolder ? string.Empty : entry.SizeBytes?.ToString())</td>
                                            <td>@(entry.LastModifiedUtc?.ToString("u"))</td>
                                            <td>
                                                @if (entry.IsFolder)
                                                {
                                                    <a href="#" @onclick="() => NavigateToFolderAsync(entry.Path)">Open</a>
                                                }
                                                else
                                                {
                                                    <a href="@FileApiClient.BuildDownloadUrl(entry.Path)">Download</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </section>
        </div>
    </section>
}

@code {
    private const long MaxUploadSizeBytes = 10L * 1024L * 1024L * 1024L;

    private readonly List<FileNodeDto> folderItems = [];
    private readonly List<FileNodeDto> searchResults = [];
    private readonly HashSet<string> selectedPaths = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<TreeNode> rootTreeNodes = [];
    private readonly Stack<string> backHistory = new();
    private readonly Stack<string> forwardHistory = new();

    private string currentFolderPath = string.Empty;
    private string newFolderName = string.Empty;
    private string renameTargetName = string.Empty;
    private string moveDestinationPath = string.Empty;
    private string searchQuery = string.Empty;

    private bool isBusy;
    private bool showCreateFolderForm;
    private bool showRenameForm;
    private bool showMoveForm;
    private bool showSearchResults;
    private string? statusMessage;
    private string? errorMessage;
    private bool hasPendingEventRefresh;

    private bool CanCreateFolder => AuthSession.HasPermission(PermissionKeys.Add);
    private bool CanUpload => AuthSession.HasPermission(PermissionKeys.Upload);
    private bool CanSearch => AuthSession.HasPermission(PermissionKeys.Search);
    private bool CanRenameSelection => AuthSession.HasPermission(PermissionKeys.Rename) && selectedPaths.Count == 1 && !showSearchResults;
    private bool CanMoveSelection => AuthSession.HasPermission(PermissionKeys.Move) && selectedPaths.Count > 0 && !showSearchResults;
    private bool CanDeleteSelection => AuthSession.HasPermission(PermissionKeys.Delete) && selectedPaths.Count > 0 && !showSearchResults;
    private bool CanDownloadSelection =>
        AuthSession.HasPermission(PermissionKeys.Download) &&
        selectedPaths.Count == 1 &&
        folderItems.Any(item => selectedPaths.Contains(item.Path) && !item.IsFolder) &&
        !showSearchResults;
    private bool AllVisibleSelected => folderItems.Count > 0 && folderItems.All(item => selectedPaths.Contains(item.Path));
    private bool CanGoBack => backHistory.Count > 0;
    private bool CanGoForward => forwardHistory.Count > 0;

    private RenderFragment TreeBranch(IEnumerable<TreeNode> nodes) => __builder =>
    {
        var seq = 0;
        __builder.OpenElement(seq++, "ul");
        __builder.AddAttribute(seq++, "class", "tree-list");

        foreach (var node in nodes.OrderBy(n => n.Name, StringComparer.OrdinalIgnoreCase))
        {
            __builder.OpenElement(seq++, "li");

            __builder.OpenElement(seq++, "div");
            __builder.AddAttribute(seq++, "class", $"tree-node-row {(IsCurrentPath(node.Path) ? "active" : string.Empty)}");

            __builder.OpenElement(seq++, "button");
            __builder.AddAttribute(seq++, "class", "tree-toggle");
            __builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => ToggleTreeNodeAsync(node)));
            __builder.AddContent(seq++, node.IsExpanded ? "▾" : "▸");
            __builder.CloseElement();

            __builder.OpenElement(seq++, "button");
            __builder.AddAttribute(seq++, "class", "tree-link");
            __builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => NavigateToFolderAsync(node.Path)));
            __builder.AddContent(seq++, node.Name);
            __builder.CloseElement();

            __builder.CloseElement();

            if (node.IsExpanded)
            {
                if (node.IsLoading)
                {
                    __builder.OpenElement(seq++, "div");
                    __builder.AddAttribute(seq++, "class", "text-muted");
                    __builder.AddContent(seq++, "Loading...");
                    __builder.CloseElement();
                }
                else
                {
                    __builder.AddContent(seq++, TreeBranch(node.Children));
                }
            }

            __builder.CloseElement();
        }

        __builder.CloseElement();
    };

    protected override Task OnInitializedAsync()
    {
        FileEventsClient.FileChanged += OnFileChanged;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.InitializeAsync();
        StateHasChanged();

        if (!AuthSession.HasActiveSession)
        {
            var returnUrl = Uri.EscapeDataString("/files");
            Navigation.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: false);
            return;
        }

        await AuthSession.RememberPathAsync("/files");
        await FileEventsClient.StartAsync();
        await EnsureTreeLoadedAsync();
        await LoadCurrentFolderAsync();
        await EnsureTreePathExpandedAsync(currentFolderPath);
        await SyncSubscriptionsAsync();
        StateHasChanged();
    }

    private async Task HandleUploadAsync(InputFileChangeEventArgs args)
    {
        var selectedFiles = args.GetMultipleFiles();
        if (selectedFiles.Count == 0)
        {
            return;
        }

        isBusy = true;
        statusMessage = null;
        errorMessage = null;

        try
        {
            var uploadedCount = 0;
            foreach (var selectedFile in selectedFiles)
            {
                await FileApiClient.UploadAsync(selectedFile, MaxUploadSizeBytes, currentFolderPath, CreateCorrelationId());
                uploadedCount++;
            }

            statusMessage = uploadedCount == 1
                ? "Uploaded 1 file."
                : $"Uploaded {uploadedCount} files.";

            await LoadCurrentFolderAsync();
            await EnsureTreeLoadedAsync(forceReload: true);
            await EnsureTreePathExpandedAsync(currentFolderPath);
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LoadFilesAsync()
    {
        await LoadCurrentFolderAsync();
        await EnsureTreeLoadedAsync(forceReload: true);
        await EnsureTreePathExpandedAsync(currentFolderPath);
    }

    private async Task LoadCurrentFolderAsync()
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            var response = await FileApiClient.ListFolderAsync(currentFolderPath);
            currentFolderPath = NormalizePath(response.CurrentPath);
            folderItems.Clear();
            folderItems.AddRange(response.Items);
            PruneSelection();
            await SyncSubscriptionsAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleUnauthorizedAsync(string? message)
    {
        await AuthSession.ClearAsync();
        var returnUrl = Uri.EscapeDataString("/files");
        Navigation.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: false);
        errorMessage = message;
    }

    private async Task SyncSubscriptionsAsync()
    {
        await FileEventsClient.SetSubscriptionsAsync([currentFolderPath]);
    }

    private void OnFileChanged(FileChangeEventDto change)
    {
        if (!IsEventRelevant(change, currentFolderPath))
        {
            return;
        }

        hasPendingEventRefresh = true;
        _ = InvokeAsync(RefreshFromEventAsync);
    }

    private async Task RefreshFromEventAsync()
    {
        if (isBusy || !hasPendingEventRefresh)
        {
            return;
        }

        hasPendingEventRefresh = false;
        statusMessage = "Folder updated.";
        await LoadCurrentFolderAsync();
        await EnsureTreeLoadedAsync(forceReload: true);
        await EnsureTreePathExpandedAsync(currentFolderPath);
        StateHasChanged();
    }

    private static bool IsEventRelevant(FileChangeEventDto change, string currentPath)
    {
        var normalizedCurrentPath = NormalizePath(currentPath);
        var normalizedScopePath = NormalizePath(change.ScopePath);

        return string.Equals(normalizedCurrentPath, normalizedScopePath, StringComparison.OrdinalIgnoreCase) ||
            normalizedCurrentPath.StartsWith(normalizedScopePath + "/", StringComparison.OrdinalIgnoreCase) ||
            normalizedScopePath.StartsWith(normalizedCurrentPath + "/", StringComparison.OrdinalIgnoreCase);
    }

    private static string NormalizePath(string? path)
    {
        return string.IsNullOrWhiteSpace(path)
            ? string.Empty
            : path.Replace('\\', '/').Trim('/');
    }

    private async Task NavigateToFolderAsync(string path)
    {
        var normalizedTarget = NormalizePath(path);
        if (!string.Equals(normalizedTarget, currentFolderPath, StringComparison.OrdinalIgnoreCase))
        {
            backHistory.Push(currentFolderPath);
            forwardHistory.Clear();
        }

        currentFolderPath = normalizedTarget;
        selectedPaths.Clear();
        showSearchResults = false;
        await LoadCurrentFolderAsync();
        await EnsureTreePathExpandedAsync(currentFolderPath);
    }

    private async Task GoBackAsync()
    {
        if (!CanGoBack)
        {
            return;
        }

        forwardHistory.Push(currentFolderPath);
        var target = backHistory.Pop();
        currentFolderPath = NormalizePath(target);
        selectedPaths.Clear();
        showSearchResults = false;
        await LoadCurrentFolderAsync();
        await EnsureTreePathExpandedAsync(currentFolderPath);
    }

    private async Task GoForwardAsync()
    {
        if (!CanGoForward)
        {
            return;
        }

        backHistory.Push(currentFolderPath);
        var target = forwardHistory.Pop();
        currentFolderPath = NormalizePath(target);
        selectedPaths.Clear();
        showSearchResults = false;
        await LoadCurrentFolderAsync();
        await EnsureTreePathExpandedAsync(currentFolderPath);
    }

    private async Task NavigateUpAsync()
    {
        if (string.IsNullOrWhiteSpace(currentFolderPath))
        {
            return;
        }

        var parts = currentFolderPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var parentPath = parts.Length <= 1
            ? string.Empty
            : string.Join('/', parts.Take(parts.Length - 1));

        await NavigateToFolderAsync(parentPath);
    }

    private async Task HandleRowDoubleClickAsync(FileNodeDto item)
    {
        if (item.IsFolder)
        {
            await NavigateToFolderAsync(item.Path);
        }
    }

    private async Task OpenFromSearchAsync(string path)
    {
        await NavigateToFolderAsync(path);
    }

    private async Task RunSearchAsync()
    {
        if (!CanSearch)
        {
            return;
        }

        var query = searchQuery.Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            errorMessage = "Search query is required.";
            return;
        }

        isBusy = true;
        errorMessage = null;
        statusMessage = null;

        try
        {
            var response = await FileApiClient.SearchAsync(query, currentFolderPath);
            searchResults.Clear();
            searchResults.AddRange(response.Items);
            showSearchResults = true;
            selectedPaths.Clear();
            statusMessage = $"Search returned {searchResults.Count} item(s).";
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ClearSearch()
    {
        showSearchResults = false;
        searchResults.Clear();
        errorMessage = null;
    }

    private void ToggleSelection(string path, ChangeEventArgs args)
    {
        var selected = IsChecked(args.Value);
        if (selected)
        {
            selectedPaths.Add(path);
        }
        else
        {
            selectedPaths.Remove(path);
        }
    }

    private void ToggleSelectAll(ChangeEventArgs args)
    {
        var selected = IsChecked(args.Value);
        if (selected)
        {
            foreach (var item in folderItems)
            {
                selectedPaths.Add(item.Path);
            }
        }
        else
        {
            selectedPaths.Clear();
        }
    }

    private void BeginCreateFolder()
    {
        showCreateFolderForm = true;
        showRenameForm = false;
        showMoveForm = false;
        newFolderName = string.Empty;
    }

    private void BeginRename()
    {
        if (!CanRenameSelection)
        {
            return;
        }

        showCreateFolderForm = false;
        showRenameForm = true;
        showMoveForm = false;

        var selected = folderItems.FirstOrDefault(item => selectedPaths.Contains(item.Path));
        renameTargetName = selected?.Name ?? string.Empty;
    }

    private void BeginMove()
    {
        if (!CanMoveSelection)
        {
            return;
        }

        showCreateFolderForm = false;
        showRenameForm = false;
        showMoveForm = true;
        moveDestinationPath = string.Empty;
    }

    private void CancelInlineAction()
    {
        showCreateFolderForm = false;
        showRenameForm = false;
        showMoveForm = false;
        newFolderName = string.Empty;
        renameTargetName = string.Empty;
        moveDestinationPath = string.Empty;
    }

    private async Task CreateFolderAsync()
    {
        if (!CanCreateFolder)
        {
            return;
        }

        var folderName = newFolderName.Trim();
        if (string.IsNullOrWhiteSpace(folderName))
        {
            errorMessage = "Folder name is required.";
            return;
        }

        isBusy = true;
        errorMessage = null;
        statusMessage = null;

        try
        {
            await FileApiClient.CreateFolderAsync(currentFolderPath, folderName, CreateCorrelationId());
            statusMessage = $"Created folder '{folderName}'.";
            CancelInlineAction();
            await LoadCurrentFolderAsync();
            await EnsureTreeLoadedAsync(forceReload: true);
            await EnsureTreePathExpandedAsync(currentFolderPath);
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RenameSelectedAsync()
    {
        if (!CanRenameSelection)
        {
            return;
        }

        var selectedPath = selectedPaths.First();
        var newName = renameTargetName.Trim();
        if (string.IsNullOrWhiteSpace(newName))
        {
            errorMessage = "New name is required.";
            return;
        }

        isBusy = true;
        errorMessage = null;
        statusMessage = null;

        try
        {
            await FileApiClient.RenameAsync(selectedPath, newName, CreateCorrelationId());
            statusMessage = "Rename completed.";
            selectedPaths.Clear();
            CancelInlineAction();
            await LoadCurrentFolderAsync();
            await EnsureTreeLoadedAsync(forceReload: true);
            await EnsureTreePathExpandedAsync(currentFolderPath);
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task MoveSelectedAsync()
    {
        if (!CanMoveSelection)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;
        statusMessage = null;

        try
        {
            var destination = NormalizePath(moveDestinationPath);
            await FileApiClient.MoveAsync(selectedPaths.ToArray(), destination, CreateCorrelationId());
            statusMessage = "Move completed.";
            selectedPaths.Clear();
            CancelInlineAction();
            await LoadCurrentFolderAsync();
            await EnsureTreeLoadedAsync(forceReload: true);
            await EnsureTreePathExpandedAsync(currentFolderPath);
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteSelectedAsync()
    {
        if (!CanDeleteSelection)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;
        statusMessage = null;

        try
        {
            await FileApiClient.DeleteAsync(selectedPaths.ToArray(), CreateCorrelationId());
            statusMessage = "Delete completed.";
            selectedPaths.Clear();
            CancelInlineAction();
            await LoadCurrentFolderAsync();
            await EnsureTreeLoadedAsync(forceReload: true);
            await EnsureTreePathExpandedAsync(currentFolderPath);
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void DownloadSelected()
    {
        if (!CanDownloadSelection)
        {
            return;
        }

        var selected = folderItems.FirstOrDefault(item => selectedPaths.Contains(item.Path) && !item.IsFolder);
        if (selected is null)
        {
            return;
        }

        Navigation.NavigateTo(FileApiClient.BuildDownloadUrl(selected.Path), forceLoad: true);
    }

    private void PruneSelection()
    {
        var visiblePaths = folderItems.Select(item => item.Path).ToHashSet(StringComparer.OrdinalIgnoreCase);
        selectedPaths.RemoveWhere(path => !visiblePaths.Contains(path));
    }

    private IEnumerable<BreadcrumbItem> GetBreadcrumbs()
    {
        if (string.IsNullOrWhiteSpace(currentFolderPath))
        {
            yield break;
        }

        var segments = currentFolderPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        for (var i = 0; i < segments.Length; i++)
        {
            var path = string.Join('/', segments.Take(i + 1));
            yield return new BreadcrumbItem(segments[i], path, i == segments.Length - 1);
        }
    }

    private async Task EnsureTreeLoadedAsync(bool forceReload = false)
    {
        if (rootTreeNodes.Count > 0 && !forceReload)
        {
            return;
        }

        var children = await FileApiClient.ListTreeChildrenAsync(string.Empty);
        rootTreeNodes.Clear();
        foreach (var child in children.Children)
        {
            rootTreeNodes.Add(ToTreeNode(child));
        }
    }

    private async Task ToggleTreeNodeAsync(TreeNode node)
    {
        if (!node.IsExpanded)
        {
            await LoadTreeChildrenAsync(node);
            node.IsExpanded = true;
        }
        else
        {
            node.IsExpanded = false;
        }
    }

    private async Task LoadTreeChildrenAsync(TreeNode node)
    {
        if (node.HasLoadedChildren)
        {
            return;
        }

        node.IsLoading = true;
        StateHasChanged();

        try
        {
            var response = await FileApiClient.ListTreeChildrenAsync(node.Path);
            node.Children.Clear();
            foreach (var child in response.Children)
            {
                node.Children.Add(ToTreeNode(child));
            }

            node.HasLoadedChildren = true;
        }
        finally
        {
            node.IsLoading = false;
        }
    }

    private async Task EnsureTreePathExpandedAsync(string path)
    {
        var normalizedPath = NormalizePath(path);
        if (string.IsNullOrWhiteSpace(normalizedPath))
        {
            return;
        }

        var segments = normalizedPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var runningPath = string.Empty;
        var currentNodes = rootTreeNodes;

        for (var i = 0; i < segments.Length; i++)
        {
            runningPath = string.IsNullOrWhiteSpace(runningPath)
                ? segments[i]
                : $"{runningPath}/{segments[i]}";

            var match = currentNodes.FirstOrDefault(node => string.Equals(node.Path, runningPath, StringComparison.OrdinalIgnoreCase));
            if (match is null)
            {
                break;
            }

            match.IsExpanded = true;

            if (i < segments.Length - 1)
            {
                await LoadTreeChildrenAsync(match);
                currentNodes = match.Children;
            }
        }

        StateHasChanged();
    }

    private bool IsCurrentPath(string path)
        => string.Equals(NormalizePath(path), currentFolderPath, StringComparison.OrdinalIgnoreCase);

    private static TreeNode ToTreeNode(FileNodeDto dto)
        => new()
        {
            Path = NormalizePath(dto.Path),
            Name = dto.Name,
            IsExpanded = false,
            IsLoading = false,
            HasLoadedChildren = false
        };

    private static bool IsChecked(object? value)
        => value is bool boolValue
            ? boolValue
            : string.Equals(value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    private static string CreateCorrelationId()
        => Guid.NewGuid().ToString("N");

    public async ValueTask DisposeAsync()
    {
        FileEventsClient.FileChanged -= OnFileChanged;
        await FileEventsClient.DisposeAsync();
    }

    private sealed record BreadcrumbItem(string Name, string Path, bool IsCurrent);

    private sealed class TreeNode
    {
        public string Path { get; init; } = string.Empty;
        public string Name { get; init; } = string.Empty;
        public bool IsExpanded { get; set; }
        public bool IsLoading { get; set; }
        public bool HasLoadedChildren { get; set; }
        public List<TreeNode> Children { get; } = [];
    }
}
