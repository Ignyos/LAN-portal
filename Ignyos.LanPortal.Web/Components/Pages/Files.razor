@page "/files"
@rendermode InteractiveServer
@using Ignyos.LanPortal.Contracts
@using Ignyos.LanPortal.Web.Services
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@inject FileApiClient FileApiClient
@inject AuthSession AuthSession

<PageTitle>Files</PageTitle>

<h1>File Explorer</h1>

<p>Browse files and folders from Machine A storage.</p>

@if (!AuthSession.IsLoaded)
{
    <p>Loading session...</p>
}
else if (!AuthSession.HasActiveSession)
{
    <p class="text-warning">Redirecting to login...</p>
}
else
{
    <div class="mb-3 d-flex gap-2 align-items-center">
        <InputFile OnChange="HandleUploadAsync" disabled="@isBusy" />
        <button class="btn btn-secondary" @onclick="LoadFilesAsync" disabled="@isBusy">Refresh</button>
    </div>

    <div class="mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item">
                    <a href="#" @onclick="() => NavigateToFolder(string.Empty)">Root</a>
                </li>
                @foreach (var crumb in GetBreadcrumbs())
                {
                    if (crumb.IsCurrent)
                    {
                        <li class="breadcrumb-item active" aria-current="page">@crumb.Name</li>
                    }
                    else
                    {
                        <li class="breadcrumb-item">
                            <a href="#" @onclick="() => NavigateToFolder(crumb.Path)">@crumb.Name</a>
                        </li>
                    }
                }
            </ol>
        </nav>
        <div class="text-muted small">Current folder: @(string.IsNullOrWhiteSpace(currentFolderPath) ? "Root" : currentFolderPath)</div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <p>@statusMessage</p>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="text-danger">@errorMessage</p>
    }

    @if (files.Count == 0)
    {
        <p><em>No files found in storage.</em></p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Size (bytes)</th>
                    <th>Last Modified (UTC)</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!string.IsNullOrWhiteSpace(currentFolderPath))
                {
                    <tr>
                        <td><a href="#" @onclick="NavigateUp">..</a></td>
                        <td>Folder</td>
                        <td></td>
                        <td></td>
                        <td><a href="#" @onclick="NavigateUp">Open</a></td>
                    </tr>
                }

                @foreach (var entry in explorerEntries)
                {
                    <tr>
                        <td>@entry.Name</td>
                        <td>@(entry.IsFolder ? "Folder" : "File")</td>
                        <td>@(entry.IsFolder ? string.Empty : entry.SizeBytes?.ToString())</td>
                        <td>@(entry.LastModifiedUtc?.ToString("u"))</td>
                        <td>
                            @if (entry.IsFolder)
                            {
                                <a href="#" @onclick="() => NavigateToFolder(entry.Path)">Open</a>
                            }
                            else
                            {
                                <a href="@FileApiClient.BuildDownloadUrl(entry.Path)">Download</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private const long MaxUploadSizeBytes = 10L * 1024L * 1024L * 1024L;

    private readonly List<FileEntryDto> files = [];
    private readonly List<ExplorerEntry> explorerEntries = [];

    private string currentFolderPath = string.Empty;

    private bool isBusy;
    private string? statusMessage;
    private string? errorMessage;

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.InitializeAsync();
        StateHasChanged();

        if (!AuthSession.HasActiveSession)
        {
            var returnUrl = Uri.EscapeDataString("/files");
            Navigation.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: false);
            return;
        }

        await AuthSession.RememberPathAsync("/files");
        await LoadFilesAsync();
        StateHasChanged();
    }

    private async Task HandleUploadAsync(InputFileChangeEventArgs args)
    {
        var selectedFile = args.File;
        if (selectedFile is null)
        {
            return;
        }

        isBusy = true;
        statusMessage = null;
        errorMessage = null;

        try
        {
            var result = await FileApiClient.UploadAsync(selectedFile, MaxUploadSizeBytes);
            statusMessage = $"Uploaded {result.RelativePath} ({result.SizeBytes} bytes).";
            await LoadFilesAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LoadFilesAsync()
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            var fetchedFiles = await FileApiClient.ListFilesAsync();
            files.Clear();
            files.AddRange(fetchedFiles);
            RebuildExplorerEntries();
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleUnauthorizedAsync(string? message)
    {
        await AuthSession.ClearAsync();
        var returnUrl = Uri.EscapeDataString("/files");
        Navigation.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: false);
        errorMessage = message;
    }

    private void RebuildExplorerEntries()
    {
        explorerEntries.Clear();

        var normalizedFiles = files
            .Select(file => new NormalizedFile(file, NormalizePath(file.RelativePath)))
            .Where(file => !string.IsNullOrWhiteSpace(file.Path))
            .ToList();

        var folderMap = BuildFolderMap(normalizedFiles);

        var folderEntries = folderMap
            .Where(folder => IsDirectChildFolder(folder.Key, currentFolderPath))
            .Select(folder => new ExplorerEntry(
                Name: GetLastSegment(folder.Key),
                Path: folder.Key,
                IsFolder: true,
                SizeBytes: null,
                LastModifiedUtc: folder.Value))
            .OrderBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase);

        var fileEntries = normalizedFiles
            .Where(file => IsDirectChildFile(file.Path, currentFolderPath))
            .Select(file => new ExplorerEntry(
                Name: GetLastSegment(file.Path),
                Path: file.Path,
                IsFolder: false,
                SizeBytes: file.Source.SizeBytes,
                LastModifiedUtc: file.Source.LastModifiedUtc))
            .OrderBy(entry => entry.Name, StringComparer.OrdinalIgnoreCase);

        explorerEntries.AddRange(folderEntries);
        explorerEntries.AddRange(fileEntries);
    }

    private static Dictionary<string, DateTimeOffset> BuildFolderMap(IEnumerable<NormalizedFile> normalizedFiles)
    {
        var folderMap = new Dictionary<string, DateTimeOffset>(StringComparer.OrdinalIgnoreCase);

        foreach (var file in normalizedFiles)
        {
            var parts = file.Path.Split('/', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length <= 1)
            {
                continue;
            }

            var running = string.Empty;
            for (var i = 0; i < parts.Length - 1; i++)
            {
                running = string.IsNullOrWhiteSpace(running)
                    ? parts[i]
                    : $"{running}/{parts[i]}";

                if (!folderMap.TryGetValue(running, out var existing) || file.Source.LastModifiedUtc > existing)
                {
                    folderMap[running] = file.Source.LastModifiedUtc;
                }
            }
        }

        return folderMap;
    }

    private static bool IsDirectChildFolder(string folderPath, string currentPath)
    {
        var prefix = string.IsNullOrWhiteSpace(currentPath) ? string.Empty : currentPath + "/";
        if (!folderPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var remainder = folderPath[prefix.Length..];
        return remainder.Length > 0 && !remainder.Contains('/');
    }

    private static bool IsDirectChildFile(string filePath, string currentPath)
    {
        var prefix = string.IsNullOrWhiteSpace(currentPath) ? string.Empty : currentPath + "/";
        if (!filePath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var remainder = filePath[prefix.Length..];
        return remainder.Length > 0 && !remainder.Contains('/');
    }

    private static string NormalizePath(string path)
    {
        return path.Replace('\\', '/').Trim('/');
    }

    private static string GetLastSegment(string path)
    {
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        return segments.Length == 0 ? path : segments[^1];
    }

    private IEnumerable<BreadcrumbItem> GetBreadcrumbs()
    {
        if (string.IsNullOrWhiteSpace(currentFolderPath))
        {
            yield break;
        }

        var segments = currentFolderPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        for (var i = 0; i < segments.Length; i++)
        {
            var path = string.Join('/', segments.Take(i + 1));
            yield return new BreadcrumbItem(segments[i], path, i == segments.Length - 1);
        }
    }

    private Task NavigateToFolder(string path)
    {
        currentFolderPath = NormalizePath(path);
        RebuildExplorerEntries();
        return Task.CompletedTask;
    }

    private Task NavigateUp()
    {
        if (string.IsNullOrWhiteSpace(currentFolderPath))
        {
            return Task.CompletedTask;
        }

        var parts = currentFolderPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        currentFolderPath = parts.Length <= 1
            ? string.Empty
            : string.Join('/', parts.Take(parts.Length - 1));

        RebuildExplorerEntries();
        return Task.CompletedTask;
    }

    private sealed record ExplorerEntry(
        string Name,
        string Path,
        bool IsFolder,
        long? SizeBytes,
        DateTimeOffset? LastModifiedUtc);

    private sealed record NormalizedFile(FileEntryDto Source, string Path);

    private sealed record BreadcrumbItem(string Name, string Path, bool IsCurrent);

}
