@page "/admin"
@rendermode InteractiveServer
@using Ignyos.LanPortal.Contracts
@using Ignyos.LanPortal.Web.Services
@implements IDisposable
@inject NavigationManager Navigation
@inject AuthSession AuthSession
@inject AdminApiClient AdminApiClient

<PageTitle>Admin</PageTitle>

<section class="view-header">
    <h1>Admin</h1>
    <p>Manage pending login requests and active user sessions for this network.</p>
</section>

@if (!AuthSession.IsLoaded)
{
    <p>Loading session...</p>
}
else if (!AuthSession.HasActiveSession)
{
    <div class="notice notice-warning">
        Not authenticated. Please <a href="/login">log in</a>.
    </div>
}
else if (!AuthSession.HasRole("Admin"))
{
    <div class="notice notice-danger">You do not have permission to view this page.</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="notice notice-success">@statusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="notice notice-danger">@errorMessage</div>
    }

    <section class="panel reveal" style="margin-top: 0.8rem;">
        <h2>Pending Login Requests</h2>

        @if (pendingRequests.Count == 0)
        {
            <p class="text-muted"><em>No pending requests.</em></p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Requested User</th>
                            <th>Device</th>
                            <th>Source</th>
                            <th>Requested (UTC)</th>
                            <th>Approve As</th>
                            <th>Roles</th>
                            <th>Expires After</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in pendingRequests)
                        {
                            var draft = GetOrCreateDraft(req);
                            <tr>
                                <td>@req.RequestedUserName</td>
                                <td>@req.DeviceName</td>
                                <td class="text-mono">@req.SourceIp</td>
                                <td>@req.CreatedAtUtc.ToString("u")</td>
                                <td>
                                    <input class="input"
                                           value="@draft.UserName"
                                           @oninput="(e) => draft.UserName = e.Value?.ToString() ?? string.Empty" />
                                </td>
                                <td>
                                    <select multiple size="2" @onchange="(args) => OnApprovalRoleChanged(req.RequestId, args)">
                                        <option value="User" selected='@draft.Roles.Contains("User")'>User</option>
                                        <option value="Admin" selected='@draft.Roles.Contains("Admin")'>Admin</option>
                                    </select>
                                    <div class="text-muted">Hold Ctrl/Cmd for multiple</div>
                                </td>
                                <td>
                                    <select value="@draft.ExpiryOption" @onchange="(args) => OnExpiryChanged(req.RequestId, args)">
                                        <option value="60">1 hour</option>
                                        <option value="1440">1 day</option>
                                        <option value="10080">1 week</option>
                                        <option value="never">Never</option>
                                        <option value="custom">Custom</option>
                                    </select>
                                    @if (draft.ExpiryOption == "custom")
                                    {
                                        <div class="field">
                                            <input class="input" type="number" min="1" max="87600"
                                                   value="@draft.CustomHours"
                                                   @oninput="(e) => { if (int.TryParse(e.Value?.ToString(), out var h)) draft.CustomHours = h; }"
                                                   placeholder="hours" />
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="actions-row" style="margin-top: 0;">
                                        <button class="btn btn-primary"
                                                @onclick="() => ApproveAsync(req)"
                                                disabled="@isBusy">Approve</button>
                                        <button class="btn btn-outline"
                                                @onclick="() => DenyAsync(req)"
                                                disabled="@isBusy">Deny</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel reveal" style="margin-top: 0.8rem;">
        <h2>Manage Active Sessions</h2>
        <p class="text-muted">Revoke all sessions matching a user or device, or update individual session roles.</p>

        <div class="split" style="margin-top: 0.5rem;">
            <div class="span-4">
                <label for="revokeUserName">User Name</label>
                <input id="revokeUserName" class="input" @bind="revokeUserName" />
            </div>
            <div class="span-4">
                <label for="revokeDeviceName">Device Name</label>
                <input id="revokeDeviceName" class="input" @bind="revokeDeviceName" />
            </div>
            <div class="span-4" style="display: flex; align-items: end;">
                <button class="btn btn-danger-outline" style="width: 100%;" @onclick="RevokeByFilterAsync" disabled="@isBusy">Revoke By Filter</button>
            </div>
        </div>

        @if (sessions.Count == 0)
        {
            <p class="text-muted"><em>No active sessions.</em></p>
        }
        else
        {
            <div class="table-wrap" style="margin-top: 0.8rem;">
                <table>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Device</th>
                            <th>Roles</th>
                            <th>Issued (UTC)</th>
                            <th>Expires (UTC)</th>
                            <th>Last Seen (UTC)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in sessions)
                        {
                            <tr>
                                <td>
                                    @session.UserName
                                    @if (session.IsCurrentSession)
                                    {
                                        <span class="badge">You</span>
                                    }
                                </td>
                                <td>@session.DeviceName</td>
                                <td>
                                    <select multiple size="2" @onchange="(args) => OnSessionRoleChanged(session.SessionId, args)">
                                        <option value="User" selected='@IsSessionRoleSelected(session.SessionId, "User")'>User</option>
                                        <option value="Admin" selected='@IsSessionRoleSelected(session.SessionId, "Admin")'>Admin</option>
                                    </select>
                                </td>
                                <td>@session.IssuedAtUtc.ToString("u")</td>
                                <td>@GetSessionExpiryDisplay(session.ExpiresAtUtc)</td>
                                <td>@session.LastSeenAtUtc.ToString("u")</td>
                                <td>
                                    <div class="actions-row" style="margin-top: 0;">
                                        <button class="btn btn-outline"
                                                @onclick="() => UpdateRolesAsync(session)"
                                                disabled="@isBusy">Save Roles</button>
                                        <button class="btn btn-danger"
                                                @onclick="() => RevokeSessionAsync(session)"
                                                disabled="@isBusy">Revoke</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private readonly List<PendingLoginRequestDto> pendingRequests = [];
    private readonly Dictionary<Guid, ApprovalDraft> approvalDrafts = [];

    private readonly List<AccessSessionDto> sessions = [];
    private readonly Dictionary<Guid, HashSet<string>> sessionRoleSelections = [];

    private bool isBusy;
    private bool initialized;
    private string revokeUserName = string.Empty;
    private string revokeDeviceName = string.Empty;
    private string? statusMessage;
    private string? errorMessage;
    private Timer? pendingTimer;
    private Timer? sessionsTimer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.InitializeAsync();
        StateHasChanged();

        if (!AuthSession.HasActiveSession)
        {
            var returnUrl = Uri.EscapeDataString("/admin");
            Navigation.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: false);
            return;
        }

        if (!AuthSession.HasRole("Admin"))
        {
            return;
        }

        initialized = true;
        await AuthSession.RememberPathAsync("/admin");
        await Task.WhenAll(PollPendingAsync(), PollSessionsAsync());
        StateHasChanged();

        pendingTimer = new Timer(async _ =>
        {
            if (!initialized)
            {
                return;
            }

            await PollPendingAsync();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));

        sessionsTimer = new Timer(async _ =>
        {
            if (!initialized)
            {
                return;
            }

            await PollSessionsAsync();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    public void Dispose()
    {
        initialized = false;
        pendingTimer?.Dispose();
        sessionsTimer?.Dispose();
    }

    private async Task PollPendingAsync()
    {
        try
        {
            var fetched = await AdminApiClient.ListPendingApprovalsAsync();

            var activeIds = fetched.Select(r => r.RequestId).ToHashSet();
            foreach (var key in approvalDrafts.Keys.Where(id => !activeIds.Contains(id)).ToList())
            {
                approvalDrafts.Remove(key);
            }

            pendingRequests.Clear();
            pendingRequests.AddRange(fetched);

            foreach (var req in pendingRequests)
            {
                GetOrCreateDraft(req);
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch
        {
        }
    }

    private async Task PollSessionsAsync()
    {
        try
        {
            var fetched = await AdminApiClient.ListActiveSessionsAsync();

            var updatedSelections = new Dictionary<Guid, HashSet<string>>();
            foreach (var session in fetched)
            {
                updatedSelections[session.SessionId] = sessionRoleSelections.TryGetValue(session.SessionId, out var existing)
                    ? existing
                    : ParseRoles(session.Roles);
            }

            sessions.Clear();
            sessions.AddRange(fetched);
            sessionRoleSelections.Clear();
            foreach (var (id, roles) in updatedSelections)
            {
                sessionRoleSelections[id] = roles;
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch
        {
        }
    }

    private async Task ApproveAsync(PendingLoginRequestDto req)
    {
        var draft = GetOrCreateDraft(req);
        if (string.IsNullOrWhiteSpace(draft.UserName))
        {
            errorMessage = "User Name is required before approving.";
            return;
        }

        isBusy = true;
        statusMessage = null;
        errorMessage = null;

        try
        {
            var roles = draft.Roles.Count > 0
                ? string.Join(',', draft.Roles.OrderBy(r => r))
                : "User";

            int? tokenMinutes = draft.ExpiryOption switch
            {
                "never" => null,
                "custom" => Math.Max(5, Math.Min(87600 * 60, draft.CustomHours * 60)),
                _ => int.Parse(draft.ExpiryOption)
            };

            await AdminApiClient.ApproveLoginAsync(req.RequestId, new ApproveLoginRequestDto(
                draft.UserName.Trim(), roles, tokenMinutes));

            approvalDrafts.Remove(req.RequestId);
            statusMessage = $"Approved login for {draft.UserName} on {req.DeviceName}.";
            await Task.WhenAll(PollPendingAsync(), PollSessionsAsync());
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DenyAsync(PendingLoginRequestDto req)
    {
        isBusy = true;
        statusMessage = null;
        errorMessage = null;

        try
        {
            await AdminApiClient.DenyLoginAsync(req.RequestId, new DenyLoginRequestDto("Denied by admin user."));
            approvalDrafts.Remove(req.RequestId);
            statusMessage = $"Denied login request from {req.DeviceName}.";
            await PollPendingAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task UpdateRolesAsync(AccessSessionDto session)
    {
        isBusy = true;
        statusMessage = null;
        errorMessage = null;

        try
        {
            var selected = GetSelectedRolesCsv(session.SessionId);
            var response = await AdminApiClient.UpdateSessionRolesAsync(
                session.SessionId, selected, "Roles updated by admin user.");

            statusMessage = $"Updated roles for {session.UserName} on {session.DeviceName} to {response.Roles}.";
            await PollSessionsAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RevokeSessionAsync(AccessSessionDto session)
    {
        isBusy = true;
        statusMessage = null;
        errorMessage = null;

        try
        {
            var reason = session.IsCurrentSession
                ? "Revoked by admin user (self-revocation)."
                : "Revoked by admin user.";

            await AdminApiClient.RevokeSessionAsync(session.SessionId, reason);

            if (session.IsCurrentSession)
            {
                await AuthSession.ClearAsync();
                Navigation.NavigateTo("/login", forceLoad: false);
                return;
            }

            statusMessage = $"Revoked session for {session.UserName} on {session.DeviceName}.";
            await PollSessionsAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RevokeByFilterAsync()
    {
        if (string.IsNullOrWhiteSpace(revokeUserName) && string.IsNullOrWhiteSpace(revokeDeviceName))
        {
            errorMessage = "Provide User Name and/or Device Name.";
            statusMessage = null;
            return;
        }

        isBusy = true;
        statusMessage = null;
        errorMessage = null;

        try
        {
            var revokedCount = await AdminApiClient.RevokeByFilterAsync(
                revokeUserName, revokeDeviceName, "Revoked by admin user.");

            statusMessage = $"Revoked {revokedCount} session(s).";
            await PollSessionsAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleUnauthorizedAsync(string? message)
    {
        errorMessage = message ?? "Access denied. Please log in again.";
        await AuthSession.ClearAsync();
        var returnUrl = Uri.EscapeDataString("/admin");
        Navigation.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: false);
    }

    private ApprovalDraft GetOrCreateDraft(PendingLoginRequestDto req)
    {
        if (!approvalDrafts.TryGetValue(req.RequestId, out var draft))
        {
            draft = new ApprovalDraft
            {
                UserName = string.IsNullOrWhiteSpace(req.RequestedUserName) ? string.Empty : req.RequestedUserName.Trim()
            };
            approvalDrafts[req.RequestId] = draft;
        }

        return draft;
    }

    private void OnApprovalRoleChanged(Guid requestId, ChangeEventArgs args)
    {
        var roles = ExtractRoleValues(args);
        if (approvalDrafts.TryGetValue(requestId, out var draft))
        {
            draft.Roles = roles.Count > 0 ? roles : ["User"];
        }
    }

    private void OnExpiryChanged(Guid requestId, ChangeEventArgs args)
    {
        if (approvalDrafts.TryGetValue(requestId, out var draft))
        {
            draft.ExpiryOption = args.Value?.ToString() ?? "60";
        }
    }

    private void OnSessionRoleChanged(Guid sessionId, ChangeEventArgs args)
    {
        var values = ExtractRoleValues(args);
        sessionRoleSelections[sessionId] = values.Count > 0 ? values : ["User"];
    }

    private static HashSet<string> ExtractRoleValues(ChangeEventArgs args)
    {
        var raw = args.Value switch
        {
            string single => single.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries),
            string[] many => many,
            IEnumerable<string> enumerable => enumerable.ToArray(),
            _ => []
        };

        return raw
            .Select(NormalizeRole)
            .Where(r => !string.IsNullOrWhiteSpace(r))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private bool IsSessionRoleSelected(Guid sessionId, string role) =>
        sessionRoleSelections.TryGetValue(sessionId, out var sel) && sel.Contains(role);

    private string GetSelectedRolesCsv(Guid sessionId)
    {
        if (!sessionRoleSelections.TryGetValue(sessionId, out var sel) || sel.Count == 0)
        {
            return "User";
        }

        return string.Join(',', sel.OrderBy(r => r, StringComparer.OrdinalIgnoreCase));
    }

    private static HashSet<string> ParseRoles(string csv) =>
        csv.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
           .Select(NormalizeRole)
           .Where(r => !string.IsNullOrWhiteSpace(r))
           .ToHashSet(StringComparer.OrdinalIgnoreCase) is { Count: > 0 } set ? set : ["User"];

    private static string NormalizeRole(string role) =>
        role.Equals("admin", StringComparison.OrdinalIgnoreCase) ? "Admin" :
        role.Equals("user", StringComparison.OrdinalIgnoreCase) ? "User" :
        string.Empty;

    private static string GetSessionExpiryDisplay(DateTimeOffset? expiresAtUtc)
        => expiresAtUtc?.ToString("u") ?? "Never";

    private sealed class ApprovalDraft
    {
        public string UserName { get; set; } = string.Empty;
        public HashSet<string> Roles { get; set; } = ["User"];
        public string ExpiryOption { get; set; } = "60";
        public int CustomHours { get; set; } = 24;
    }
}
