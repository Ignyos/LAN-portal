@page "/admin"
@rendermode InteractiveServer
@using Ignyos.LanPortal.Contracts
@using Ignyos.LanPortal.Web.Services
@implements IDisposable
@inject NavigationManager Navigation
@inject AuthSession AuthSession
@inject AdminApiClient AdminApiClient

<PageTitle>Admin</PageTitle>

<section class="view-header">
    <h1>Admin</h1>
</section>

@if (!AuthSession.IsLoaded)
{
    <p>Loading session...</p>
}
else if (!AuthSession.HasActiveSession)
{
    <div class="notice notice-warning">
        Access is required. Please <a href="/account">request access</a>.
    </div>
}
else if (!AuthSession.HasRole("Admin"))
{
    <div class="notice notice-danger">You do not have permission to view this page.</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="notice notice-success">@statusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="notice notice-danger">@errorMessage</div>
    }

    <section class="panel reveal" style="margin-top: 0.8rem;">
        <h2>Pending Access Requests</h2>

        @if (pendingRequests.Count == 0)
        {
            <p class="text-muted"><em>No pending requests.</em></p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Device</th>
                            <th>Admin</th>
                            <th>Expiration</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var req in pendingRequests)
                        {
                            var draft = GetOrCreateDraft(req);
                            var rowBusy = IsRowBusy(req.RequestId);
                            <tr>
                                <td>
                                    <input class="input"
                                           value="@draft.UserName"
                                           disabled="@rowBusy"
                                           aria-label="Approved user name"
                                           @oninput="(e) => draft.UserName = e.Value?.ToString() ?? string.Empty" />
                                </td>
                                <td>
                                    <input class="input"
                                           value="@draft.DeviceName"
                                           disabled="@rowBusy"
                                           aria-label="Device name"
                                           @oninput="(e) => draft.DeviceName = e.Value?.ToString() ?? string.Empty" />
                                </td>
                                <td>
                                    <label class="checkbox-row">
                                        <input type="checkbox"
                                               checked="@draft.Roles.Contains("Admin")"
                                               disabled="@rowBusy"
                                               aria-label="Grant administrator access"
                                               @onchange="(e) => SetDraftAdmin(draft, e)" />
                                        <span>Admin</span>
                                    </label>
                                </td>
                                <td>
                                    <TokenExpirySelect Option="@draft.ExpiryOption"
                                                       OptionChanged="@(value => draft.ExpiryOption = value)"
                                                       CustomHours="@draft.CustomHours"
                                                       CustomHoursChanged="@(value => draft.CustomHours = value)"
                                                       Disabled="@rowBusy" />
                                </td>
                                <td>
                                    <div class="actions-row" style="margin-top: 0;">
                                        <button class="btn btn-primary"
                                                @onclick="() => ApproveAsync(req)"
                                                disabled="@(rowBusy || !IsDraftValid(draft))">Approve</button>
                                        <button class="btn btn-danger"
                                                title="Deny request"
                                                aria-label="Deny request from @req.DeviceName"
                                                @onclick="() => OpenDenyModal(req)"
                                                disabled="@rowBusy">&times;</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel reveal" style="margin-top: 0.8rem;">
        <h2>Manage Active Users</h2>
        <p class="text-muted">Review active users and revoke access when needed.</p>

        @if (sessions.Count == 0)
        {
            <p class="text-muted"><em>No active sessions.</em></p>
        }
        else
        {
            <div class="table-wrap" style="margin-top: 0.8rem;">
                <table>
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Device</th>
                            <th>Role</th>
                            <th>Access Expires</th>
                            <th>Revoke</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in sessions)
                        {
                            <tr>
                                <td>
                                    @session.UserName
                                    @if (session.IsCurrentSession)
                                    {
                                        <span class="badge" style="margin-left: 0.5rem;">You</span>
                                    }
                                </td>
                                <td>@session.DeviceName</td>
                                <td>@GetRoleLabel(session.Roles)</td>
                                <td>@FormatFriendlyLocalDateTime(session.ExpiresAtUtc)</td>
                                <td>
                                    <button class="btn btn-danger" title="Revoke access" aria-label="Revoke access for @session.UserName"
                                            @onclick="() => OpenRevokeModal(session)"
                                            disabled="@isBusy">&times;</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (revokeSession is not null)
    {
        <div class="modal-backdrop" role="presentation" @onclick="CloseRevokeModal">
            <section class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="revoke-user-title" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div>
                        <p class="eyebrow">Revoke access</p>
                        <h2 id="revoke-user-title">Remove access for @revokeSession.UserName</h2>
                    </div>
                    <button type="button" class="modal-close" title="Close" aria-label="Close revoke dialog" @onclick="CloseRevokeModal">&times;</button>
                </div>

                <div class="notice notice-warning" style="margin-top: 1rem;">
                    <strong>Device:</strong> @revokeSession.DeviceName
                    <br />
                    @if (revokeSession.IsCurrentSession)
                    {
                        <span>This will end your current session and return you to the account page.</span>
                    }
                    else
                    {
                        <span>This will revoke access for the selected user immediately.</span>
                    }
                </div>

                <div class="actions-row modal-actions">
                    <button type="button" class="btn btn-secondary" @onclick="CloseRevokeModal" disabled="@isBusy">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmRevokeAsync" disabled="@isBusy">Confirm Revoke</button>
                </div>
            </section>
        </div>
    }

    @if (denyRequest is not null)
    {
        <div class="modal-backdrop" role="presentation" @onclick="CloseDenyModal">
            <section class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="deny-request-title" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div>
                        <p class="eyebrow">Deny request</p>
                        <h2 id="deny-request-title">Deny access for @denyRequest.RequestedUserName</h2>
                    </div>
                    <button type="button" class="modal-close" title="Close" aria-label="Close deny dialog" @onclick="CloseDenyModal">&times;</button>
                </div>

                <div class="notice notice-warning" style="margin-top: 1rem;">
                    <strong>Device:</strong> @denyRequest.DeviceName
                    <br />
                    <span>The request will be dismissed and the waiting device will be told access was denied.</span>
                </div>

                <div class="field">
                    <label for="deny-reason">Reason (optional)</label>
                    <input id="deny-reason" class="input" @bind="denyReason" @bind:event="oninput"
                           placeholder="Shared with the requesting device" />
                </div>

                <div class="actions-row modal-actions">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDenyModal" disabled="@isBusy">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDenyAsync" disabled="@isBusy">Confirm Deny</button>
                </div>
            </section>
        </div>
    }
}

@code {
    private readonly List<PendingLoginRequestDto> pendingRequests = [];
    private readonly Dictionary<Guid, ApprovalDraft> approvalDrafts = [];

    private readonly List<AccessSessionDto> sessions = [];

    private bool isBusy;
    private readonly HashSet<Guid> busyRequests = [];
    private bool initialized;
    private AccessSessionDto? revokeSession;
    private PendingLoginRequestDto? denyRequest;
    private string denyReason = string.Empty;
    private string? statusMessage;
    private string? errorMessage;
    private Timer? pendingTimer;
    private Timer? sessionsTimer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.InitializeAsync();
        StateHasChanged();

        if (!AuthSession.HasActiveSession)
        {
            var returnUrl = Uri.EscapeDataString("/admin");
            Navigation.NavigateTo($"/account?returnUrl={returnUrl}", forceLoad: false);
            return;
        }

        if (!AuthSession.HasRole("Admin"))
        {
            return;
        }

        initialized = true;
        await AuthSession.RememberPathAsync("/admin");
        await Task.WhenAll(PollPendingAsync(), PollSessionsAsync());
        StateHasChanged();

        pendingTimer = new Timer(async _ =>
        {
            if (!initialized)
            {
                return;
            }

            await PollPendingAsync();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));

        sessionsTimer = new Timer(async _ =>
        {
            if (!initialized)
            {
                return;
            }

            await PollSessionsAsync();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    public void Dispose()
    {
        initialized = false;
        pendingTimer?.Dispose();
        sessionsTimer?.Dispose();
    }

    private async Task PollPendingAsync()
    {
        try
        {
            var fetched = await AdminApiClient.ListPendingApprovalsAsync();

            var activeIds = fetched.Select(r => r.RequestId).ToHashSet();
            foreach (var key in approvalDrafts.Keys.Where(id => !activeIds.Contains(id)).ToList())
            {
                approvalDrafts.Remove(key);
            }

            pendingRequests.Clear();
            pendingRequests.AddRange(fetched);

            foreach (var req in pendingRequests)
            {
                GetOrCreateDraft(req);
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch
        {
        }
    }

    private async Task PollSessionsAsync()
    {
        try
        {
            var fetched = await AdminApiClient.ListActiveSessionsAsync();

            sessions.Clear();
            sessions.AddRange(fetched);
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch
        {
        }
    }

    private async Task ApproveAsync(PendingLoginRequestDto req)
    {
        var draft = GetOrCreateDraft(req);
        if (!IsDraftValid(draft))
        {
            errorMessage = "User and Device are required before approving.";
            return;
        }

        busyRequests.Add(req.RequestId);
        statusMessage = null;
        errorMessage = null;

        try
        {
            var roles = draft.Roles.Count > 0
                ? string.Join(',', draft.Roles.OrderBy(r => r))
                : "User";

            var tokenMinutes = TokenExpiryOptions.ToTokenMinutes(draft.ExpiryOption, draft.CustomHours);

            await AdminApiClient.ApproveLoginAsync(req.RequestId, new ApproveLoginRequestDto(
                draft.UserName.Trim(), roles, tokenMinutes, draft.DeviceName.Trim()));

            approvalDrafts.Remove(req.RequestId);
            statusMessage = $"Approved login for {draft.UserName.Trim()} on {draft.DeviceName.Trim()}.";
            await Task.WhenAll(PollPendingAsync(), PollSessionsAsync());
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busyRequests.Remove(req.RequestId);
        }
    }

    private void OpenDenyModal(PendingLoginRequestDto req)
    {
        denyRequest = req;
        denyReason = string.Empty;
    }

    private void CloseDenyModal()
    {
        denyRequest = null;
        denyReason = string.Empty;
    }

    private async Task ConfirmDenyAsync()
    {
        if (denyRequest is null)
        {
            return;
        }

        var req = denyRequest;
        var reason = string.IsNullOrWhiteSpace(denyReason) ? "Denied by admin user." : denyReason.Trim();
        CloseDenyModal();
        await DenyAsync(req, reason);
    }

    private async Task DenyAsync(PendingLoginRequestDto req, string reason)
    {
        busyRequests.Add(req.RequestId);
        statusMessage = null;
        errorMessage = null;

        try
        {
            await AdminApiClient.DenyLoginAsync(req.RequestId, new DenyLoginRequestDto(reason));
            approvalDrafts.Remove(req.RequestId);
            statusMessage = $"Denied login request from {req.DeviceName}.";
            await PollPendingAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            busyRequests.Remove(req.RequestId);
        }
    }

    private void OpenRevokeModal(AccessSessionDto session)
    {
        revokeSession = session;
        statusMessage = null;
        errorMessage = null;
    }

    private void CloseRevokeModal()
    {
        if (!isBusy)
        {
            revokeSession = null;
        }
    }

    private async Task ConfirmRevokeAsync()
    {
        if (revokeSession is null)
        {
            return;
        }

        await RevokeSessionAsync(revokeSession);
        revokeSession = null;
    }

    private async Task RevokeSessionAsync(AccessSessionDto session)
    {
        isBusy = true;
        statusMessage = null;
        errorMessage = null;

        try
        {
            var reason = session.IsCurrentSession
                ? "Revoked by admin user (self-revocation)."
                : "Revoked by admin user.";

            await AdminApiClient.RevokeSessionAsync(session.SessionId, reason);

            if (session.IsCurrentSession)
            {
                await AuthSession.ClearAsync();
                Navigation.NavigateTo("/account", forceLoad: false);
                return;
            }

            statusMessage = $"Revoked session for {session.UserName} on {session.DeviceName}.";
            await PollSessionsAsync();
        }
        catch (UnauthorizedAccessException ex)
        {
            await HandleUnauthorizedAsync(ex.Message);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleUnauthorizedAsync(string? message)
    {
        errorMessage = message ?? "Access denied. Please request access again.";
        await AuthSession.ClearAsync();
        var returnUrl = Uri.EscapeDataString("/admin");
        Navigation.NavigateTo($"/account?returnUrl={returnUrl}", forceLoad: false);
    }

    private ApprovalDraft GetOrCreateDraft(PendingLoginRequestDto req)
    {
        if (!approvalDrafts.TryGetValue(req.RequestId, out var draft))
        {
            draft = new ApprovalDraft
            {
                UserName = string.IsNullOrWhiteSpace(req.RequestedUserName) ? string.Empty : req.RequestedUserName.Trim(),
                DeviceName = string.IsNullOrWhiteSpace(req.DeviceName) ? string.Empty : req.DeviceName.Trim()
            };
            approvalDrafts[req.RequestId] = draft;
        }

        return draft;
    }

    private bool IsRowBusy(Guid requestId) => isBusy || busyRequests.Contains(requestId);

    private static bool IsDraftValid(ApprovalDraft draft) =>
        !string.IsNullOrWhiteSpace(draft.UserName) && !string.IsNullOrWhiteSpace(draft.DeviceName);

    // Roles the UI has no control for are preserved so future add-in roles survive an approval.
    private static void SetDraftAdmin(ApprovalDraft draft, ChangeEventArgs args)
    {
        var isAdmin = args.Value is bool value && value;
        if (isAdmin)
        {
            draft.Roles.Add("Admin");
        }
        else
        {
            draft.Roles.Remove("Admin");
        }

        draft.Roles.Add("User");
    }

    private static HashSet<string> ParseRoles(string csv) =>
        csv.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
           .Select(role => role.Equals("admin", StringComparison.OrdinalIgnoreCase) ? "Admin" :
                          role.Equals("user", StringComparison.OrdinalIgnoreCase) ? "User" : role.Trim())
           .Where(r => !string.IsNullOrWhiteSpace(r))
           .ToHashSet(StringComparer.OrdinalIgnoreCase) is { Count: > 0 } set ? set : ["User"];

    private static string GetRoleLabel(string rolesCsv)
        => ParseRoles(rolesCsv).Contains("Admin") ? "Admin" : "User";

    private static string FormatFriendlyLocalDateTime(DateTimeOffset? value)
        => value is null
            ? "Never"
            : value.Value.ToLocalTime().ToString("MMM d yyyy h:mmtt").ToLowerInvariant();

    private sealed class ApprovalDraft
    {
        public string UserName { get; set; } = string.Empty;
        public string DeviceName { get; set; } = string.Empty;
        public HashSet<string> Roles { get; init; } = new(StringComparer.OrdinalIgnoreCase) { "User" };
        public string ExpiryOption { get; set; } = TokenExpiryOptions.DefaultValue;
        public int CustomHours { get; set; } = TokenExpiryOptions.DefaultCustomHours;
    }
}
