@page "/home"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject Ignyos.LanPortal.Web.Services.ToastService Toasts
@inject IJSRuntime JS

<PageTitle>LAN Portal</PageTitle>

<header class="page-header">
    <p class="eyebrow">LAN Portal</p>
</header>

<section class="panel reveal" style="max-width: 40rem;">
    <h2>Join This Network</h2>
    <p class="text-muted">Send this link:</p>
    <p class="text-mono" style="word-break: break-all;"><a href="@shareUrl">@shareUrl</a></p>

    <img
        src="@qrCodeUrl"
		alt="QR code for the LAN Portal entry link"
        width="256"
        height="256"
        style="margin-top: 0.65rem; border: 1px solid var(--line); border-radius: 0.7rem; background: #fff; padding: 0.4rem;" />

	<p class="text-muted">Scan this QR code to open LAN Portal and request access.</p>

    <div class="actions-row">
        <button class="btn btn-primary" @onclick="CopyShareLinkAsync">Copy Link</button>
		<a class="btn btn-outline" href="account">Open Account</a>
        <a class="btn btn-outline" href="files">Go To Files</a>
    </div>

</section>

@code {
	private string shareUrl = string.Empty;
	private string qrCodeUrl = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		shareUrl = Navigation.ToAbsoluteUri("/").ToString();
		qrCodeUrl = BuildQrCodeUrl(shareUrl);
	}

	private async Task CopyShareLinkAsync()
	{
		try
		{
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", shareUrl);
			Toasts.Success("Link copied.");
		}
		catch
		{
			Toasts.Warning("Could not copy automatically. Please copy the link manually.");
		}
	}

	private static string BuildQrCodeUrl(string value)
	{
		return $"https://api.qrserver.com/v1/create-qr-code/?size=256x256&data={Uri.EscapeDataString(value)}";
	}
}
