@page "/account"
@rendermode InteractiveServer
@using Ignyos.LanPortal.Contracts
@using Ignyos.LanPortal.Web.Services
@using Microsoft.AspNetCore.WebUtilities
@inject Ignyos.LanPortal.Web.Services.AuthSession AuthSession
@inject Ignyos.LanPortal.Web.Services.AuthApiClient AuthApiClient
@inject NavigationManager Navigation
@inject PortalConfigClient PortalConfigClient
@inject ToastService Toasts
@inject IJSRuntime JS

<PageTitle>@(AuthSession.HasActiveSession ? "Account" : $"{networkName} - Account")</PageTitle>

<section class="view-header">
    <h1>Account</h1>
</section>

@if (!AuthSession.IsLoaded)
{
    <p>Loading session...</p>
}
else if (!AuthSession.HasActiveSession)
{
    <section class="panel reveal">
        <h2>Request access to @networkName</h2>
        <p>Enter your name and device to request access from the host.</p>

        <div class="field">
            <label for="userName">User Name</label>
            <input id="userName" class="input" @bind="userName" />
        </div>

        <div class="field">
            <label for="deviceName">Device</label>
            <input id="deviceName" class="input" @bind="deviceName" />
        </div>

        <div class="actions-row">
            <button class="btn btn-primary" @onclick="RequestAccessAsync" disabled="@isBusy">Request Access</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="text-danger">@errorMessage</p>
        }

        @if (pendingRequest is not null)
        {
            <div class="approval-progress @(requestExpired ? "approval-progress-expired" : string.Empty)"
                 role="progressbar"
                 aria-label="Access request expiration"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-valuenow="@PendingProgressPercent">
                <div class="approval-progress-fill" style="animation-duration: @PendingDurationSeconds.ToString("F1")s;"></div>
                <div class="approval-progress-label">
                    @(requestExpired ? "Request expired." : $"Waiting for approval. {PendingTimeRemaining}")
                </div>
            </div>
        }
    </section>
}
else
{
    <section class="panel reveal account-grid">
        <div class="account-row">
            <span class="account-label">User Name</span>
            <span class="account-value">@DisplayOrUnknown(AuthSession.UserName)</span>
        </div>
        <div class="account-row">
            <span class="account-label">Device</span>
            <span class="account-value">@DisplayOrUnknown(AuthSession.DeviceName)</span>
        </div>
        <div class="account-row">
            <span class="account-label">Roles</span>
            <span class="account-value">@(AuthSession.Roles.Count == 0 ? "None" : string.Join(", ", AuthSession.Roles))</span>
        </div>
        <div class="account-row">
            <span class="account-label">Session Expires</span>
            <span class="account-value">@GetSessionExpiryDisplay()</span>
        </div>

        <div class="actions-row account-actions">
            <button class="btn btn-danger" @onclick="LogoutAsync" disabled="@isBusy">Log Out</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="text-danger">@errorMessage</p>
        }
    </section>
}

@code {
    private bool isBusy;
    private string networkName = "My Home";
    private string userName = string.Empty;
    private string deviceName = "Desktop";
    private string returnUrl = "/files";
    private string? errorMessage;
    private DeviceLoginStartResponseDto? pendingRequest;
    private DateTimeOffset? pendingStartedAtUtc;
    private bool requestExpired;
    private int requestSequence;

    private int PendingProgressPercent
    {
        get
        {
            if (pendingRequest is null || requestExpired)
            {
                return 0;
            }

            var startedAtUtc = pendingStartedAtUtc ?? DateTimeOffset.UtcNow;
            var totalSeconds = Math.Max(1, (pendingRequest.ExpiresAtUtc - startedAtUtc).TotalSeconds);
            var remainingSeconds = Math.Max(0, (pendingRequest.ExpiresAtUtc - DateTimeOffset.UtcNow).TotalSeconds);
            return (int)Math.Clamp(Math.Ceiling(remainingSeconds / totalSeconds * 100), 0, 100);
        }
    }

    private string PendingTimeRemaining
    {
        get
        {
            if (pendingRequest is null)
            {
                return "0:00";
            }

            var remaining = pendingRequest.ExpiresAtUtc - DateTimeOffset.UtcNow;
            var totalSeconds = Math.Max(0, (int)Math.Ceiling(remaining.TotalSeconds));
            return $"{totalSeconds / 60}:{totalSeconds % 60:00}";
        }
    }

    private double PendingDurationSeconds
        => pendingRequest is null || pendingStartedAtUtc is null
            ? 1
            : Math.Max(1, (pendingRequest.ExpiresAtUtc - pendingStartedAtUtc.Value).TotalSeconds);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        networkName = await PortalConfigClient.GetNetworkNameAsync();
        await AuthSession.InitializeAsync();

        var parsedUri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(parsedUri.Query);
        if (query.TryGetValue("returnUrl", out var requestedReturnUrl))
        {
            var candidate = requestedReturnUrl.ToString();
            if (!string.IsNullOrWhiteSpace(candidate) &&
                candidate.StartsWith('/') &&
                !candidate.StartsWith("//", StringComparison.Ordinal))
            {
                returnUrl = candidate;
            }
        }

        if (query.TryGetValue("reason", out var reasonValue))
        {
            var reason = reasonValue.ToString();
            if (reason == "revoked")
            {
                Toasts.Warning("Your access was revoked. Please request access again.");
            }
            else if (reason == "expired")
            {
                Toasts.Info("Your session expired. Please request access again.");
            }
        }

        if (AuthSession.HasActiveSession)
        {
            await AuthSession.RememberPathAsync("/account");
        }
        else
        {
            var suggestedDevice = await DetectDeviceAsync();
            ApplyDeviceSuggestion(suggestedDevice);
        }

        StateHasChanged();
    }

    private async Task RequestAccessAsync()
    {
        if (string.IsNullOrWhiteSpace(userName))
        {
            errorMessage = "User Name is required.";
            return;
        }

        var resolvedDeviceName = deviceName.Trim();
        if (string.IsNullOrWhiteSpace(resolvedDeviceName))
        {
            errorMessage = "Device Name is required.";
            return;
        }

        isBusy = true;
        var currentRequest = ++requestSequence;
        errorMessage = null;
        pendingRequest = null;
        pendingStartedAtUtc = null;
        requestExpired = false;

        try
        {
            pendingRequest = await AuthApiClient.StartLoginAsync(new DeviceLoginStartRequestDto(
                userName.Trim(),
                resolvedDeviceName));
            pendingStartedAtUtc = DateTimeOffset.UtcNow;
            StateHasChanged();

            var nextPollAt = DateTimeOffset.UtcNow;
            while (DateTimeOffset.UtcNow < pendingRequest.ExpiresAtUtc)
            {
                await Task.Delay(TimeSpan.FromSeconds(1));

                if (DateTimeOffset.UtcNow >= pendingRequest.ExpiresAtUtc)
                {
                    break;
                }

                StateHasChanged();
                if (DateTimeOffset.UtcNow < nextPollAt)
                {
                    continue;
                }

                nextPollAt = DateTimeOffset.UtcNow.AddSeconds(pendingRequest.PollIntervalSeconds);

                var poll = await AuthApiClient.PollLoginAsync(new DeviceLoginPollRequestDto(
                    pendingRequest.RequestId,
                    pendingRequest.UserCode));

                if (poll.Status == "pending")
                {
                    StateHasChanged();
                    continue;
                }

                if (poll.Status == "approved" &&
                    !string.IsNullOrWhiteSpace(poll.AccessToken) &&
                    poll.AccessTokenExpiresAtUtc is not null &&
                    !string.IsNullOrWhiteSpace(poll.RefreshToken))
                {
                    await AuthSession.SetTokensAsync(
                        poll.AccessToken,
                        poll.AccessTokenExpiresAtUtc.Value,
                        poll.RefreshToken,
                        poll.RefreshTokenExpiresAtUtc);
                    await AuthSession.RememberPathAsync(returnUrl);
                    Toasts.Success("Access approved. Redirecting...");
                    Navigation.NavigateTo(returnUrl);
                    return;
                }

                errorMessage = poll.Message ?? $"Access request status: {poll.Status}";
                return;
            }

            if (currentRequest != requestSequence)
            {
                return;
            }

            isBusy = false;
            requestExpired = true;
            StateHasChanged();
            await Task.Delay(TimeSpan.FromSeconds(2));

            if (currentRequest != requestSequence)
            {
                return;
            }

            pendingRequest = null;
            pendingStartedAtUtc = null;
            requestExpired = false;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            if (currentRequest == requestSequence)
            {
                isBusy = false;
            }
        }
    }

    private async Task LogoutAsync()
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            var token = AuthSession.AccessToken;
            if (!string.IsNullOrWhiteSpace(token))
            {
                await AuthApiClient.LogoutAsync(token);
            }

            await AuthSession.ClearAsync();
            Toasts.Info("Signed out.");
            Navigation.NavigateTo("/account", forceLoad: false);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private static string DisplayOrUnknown(string? value)
        => string.IsNullOrWhiteSpace(value) ? "unknown" : value;

    private async Task<string> DetectDeviceAsync()
    {
        try
        {
            var detected = await JS.InvokeAsync<string?>("lanPortalDevice.getSuggestedDeviceLabel");
            return string.IsNullOrWhiteSpace(detected) ? "Desktop" : detected.Trim();
        }
        catch
        {
            return "Desktop";
        }
    }

    private void ApplyDeviceSuggestion(string suggestedDevice)
        => deviceName = suggestedDevice;

    private static string FormatLocalDateTime(DateTimeOffset? value, string fallback = "n/a")
        => value is null ? fallback : value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private string GetSessionExpiryDisplay()
    {
        if (!string.IsNullOrWhiteSpace(AuthSession.RefreshToken) && AuthSession.RefreshTokenExpiresAtUtc is null)
        {
            return "Never";
        }

        if (AuthSession.RefreshTokenExpiresAtUtc is DateTimeOffset sessionExpiresUtc)
        {
            return FormatLocalDateTime(sessionExpiresUtc);
        }

        if (AuthSession.AccessTokenExpiresAtUtc is DateTimeOffset accessExpiresUtc)
        {
            return FormatLocalDateTime(accessExpiresUtc);
        }

        return "n/a";
    }
}
