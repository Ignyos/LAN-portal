{
  "Bootstrap": {
    "DatabasePath": "data/lanportal.db"
  },
  "UpdateChannel": {
    "BaseUrl": "https://lanportal.ignyos.com",
    "Channel": "production",
    "ProductionManifestPath": "/updates/manifest.json",
    "TestManifestPath": "/updates/manifest-test.json",
    "PollIntervalMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
