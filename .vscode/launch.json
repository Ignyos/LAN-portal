{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-solution",
      "program": "${workspaceFolder}/Ignyos.LanPortal.Api/bin/Debug/net9.0/Ignyos.LanPortal.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Ignyos.LanPortal.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5212"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/local/admin"
      }
    },
    {
      "name": "Web (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-solution",
      "program": "${workspaceFolder}/Ignyos.LanPortal.Web/bin/Debug/net9.0/Ignyos.LanPortal.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Ignyos.LanPortal.Web",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5014"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Build",
      "type": "node-terminal",
      "request": "launch",
      "command": "dotnet build ./Ignyos.LanPortal.sln",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build Dev Installer",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/scripts/build-dev-installer.ps1",
      "cwd": "${workspaceFolder}",
      "args": [
        "-Configuration",
        "Release",
        "-Runtime",
        "win-x64"
      ]
    },
    {
      "name": "Publish-live",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/scripts/publish-live.ps1",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Publish-dev",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/scripts/publish-dev.ps1",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Launch API + Web",
      "configurations": [
        "API (.NET)",
        "Web (.NET)"
      ],
      "stopAll": true
    }
  ]
}
