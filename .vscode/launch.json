{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev-Test (Host-managed API+Web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dev-test-prelaunch",
      "program": "${workspaceFolder}/Ignyos.LanPortal.Host/bin/Debug/net9.0-windows/Ignyos.LanPortal.Host.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Ignyos.LanPortal.Host",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Stop Dev Processes",
      "type": "node-terminal",
      "request": "launch",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev-processes.ps1 -WorkspaceRoot .",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Docs-Deploy",
      "type": "node-terminal",
      "request": "launch",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/docs-deploy.ps1",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Live-App-Deploy",
      "type": "node-terminal",
      "request": "launch",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/live-app-deploy.ps1",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Dev-App-Deploy",
      "type": "node-terminal",
      "request": "launch",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-app-deploy.ps1",
      "cwd": "${workspaceFolder}"
    }
  ]
}
