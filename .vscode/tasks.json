{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "stop-stale-dev-processes",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/stop-dev-processes.ps1",
        "-WorkspaceRoot",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "clean-web-build",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Remove-Item -Path '${workspaceFolder}/Ignyos.LanPortal.Web/bin', '${workspaceFolder}/Ignyos.LanPortal.Web/obj' -Recurse -Force -ErrorAction SilentlyContinue; Write-Output 'Cleaned Web project bin/obj'"
      ],
      "problemMatcher": []
    },
    {
      "label": "build-solution",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Ignyos.LanPortal.sln"
      ],
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ],
      "dependsOn": ["clean-web-build"],
      "dependsOrder": "sequence"
    },
    {
      "label": "dev-test-prelaunch",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev-test.ps1",
        "-WorkspaceRoot",
        "${workspaceFolder}"
      ],
      "problemMatcher": [
        "$msCompile"
      ]
    }
  ]
}
