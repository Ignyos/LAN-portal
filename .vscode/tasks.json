{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "stop-stale-dev-processes",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/stop-dev-processes.ps1",
        "-WorkspaceRoot",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "build-solution",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Ignyos.LanPortal.sln"
      ],
      "group": "build",
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "dev-test-prelaunch",
      "dependsOn": [
        "stop-stale-dev-processes",
        "build-solution"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
